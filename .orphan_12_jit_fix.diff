--- a/grokking_optimizers/compile.py
+++ b/grokking_optimizers/compile.py
@@ -11747,12 +11747,23 @@ def _torch_load(spec: BuildSpec, sources: List[Path],
         host_cflags = list(host_cflags) + extra_host
     if extra_device:
         device_cflags = list(device_cflags) + extra_device
+    # Host-memory guard: honour an operator-set MAX_JOBS env cap if present,
+    # else default to NCPUS. On memory-limited (cgroup) hosts the full NCPUS
+    # ninja fan-out spawns one heavy cc1plus per CUTLASS TU and can OOM-kill the
+    # compiler; an outer `MAX_JOBS=N` lets the operator bound the fan-out without
+    # changing the default behaviour when unset.
+    _maxjobs_env = os.environ.get("MAX_JOBS")
+    try:
+        _maxjobs = int(_maxjobs_env) if _maxjobs_env else NCPUS
+    except (TypeError, ValueError):
+        _maxjobs = NCPUS
+    _nvcc_threads = os.environ.get("NVCC_THREADS") or "8"
     overlay = {
-        "MAX_JOBS": NCPUS,
+        "MAX_JOBS": _maxjobs,
         "NINJA_STATUS": "[%f/%t %es] ",
         "TORCH_CUDA_VERBOSE_BUILD": "1",
-        "CMAKE_BUILD_PARALLEL_LEVEL": NCPUS,
-        "NVCC_THREADS": "8",
+        "CMAKE_BUILD_PARALLEL_LEVEL": _maxjobs,
+        "NVCC_THREADS": _nvcc_threads,
         **_sccache_env(),
     }
     if "CCACHE_DIR" in overlay:
@@ -11776,6 +11787,29 @@ def _torch_load(spec: BuildSpec, sources: List[Path],
                 with_cuda=with_cuda,
             )
         except Exception as exc:
+            # #12 GPU-validation fix — bindings.cpp pins PYBIND11_MODULE(_ops)
+            # (csrc/bindings/bindings.cpp:3439), so torch load()'s final
+            # import-by-extension-name step can NEVER succeed for a JIT module
+            # named grokking_compiled_<...> even though the artifact itself is
+            # fully linked and valid: every downstream consumer (TimingWorker,
+            # the numerical-dump subprocess, the runtime loader) imports the
+            # .so AS `_ops` via spec_from_file_location. When the build
+            # completed (the .so exists) and the failure is exactly this
+            # name-mismatch ImportError, accept the on-disk artifact — every
+            # other failure mode stays loud below.
+            if (isinstance(exc, ImportError)
+                    and "does not define module export function" in str(exc)):
+                _so_built = next(build_dir.glob(f"{module_name}*.so"), None)
+                if _so_built is not None:
+                    elapsed = time.monotonic() - t0
+                    report.write(
+                        f"\n[build OK in {elapsed:.1f}s] -> {_so_built}\n"
+                        f"  [pyinit-name] post-build python-import skipped: "
+                        f"bindings pin PYBIND11_MODULE(_ops) while this JIT "
+                        f"module is named {module_name}; the import-by-name "
+                        f"check cannot succeed by design and the artifact is "
+                        f"accepted from disk (downstream loads it as _ops).\n")
+                    return _so_built
             elapsed = time.monotonic() - t0
             # Stream — debug-flags: collect ALL ninja / log content so the
