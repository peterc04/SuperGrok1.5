+//  rows — byte-identical to the OFF path AND OOB-safe. (Padding rows are never
+//  consumed downstream: dectc_ln_fwd_tile iterates s<nrows.)
+template <int N>
+struct SynthEpiR1 {
+    float* __restrict__               work;     // sc.work base ([kTileM, d])
+    const __nv_bfloat16* __restrict__ Xin;      // acts.X_in[li] + g0*d ([nrows, d])
+    const float* __restrict__         out_b;    // L.out_b ([d])
+    int                               d;        // = Nout (out_proj N == kD)
+    int                               nrows;    // valid rows in this tile
+    int                               col_base; // current n-tile global column (n0)
+    __device__ __forceinline__ void operator()(int m, int n, float v) const {
+        const int col = col_base + n;
+        const int64_t off = (int64_t)m * d + col;
+        if (m < nrows) work[off] = v + (__bfloat162float(Xin[off]) + out_b[col]);
+        else           work[off] = v;   // padding row: raw GEMM (== OFF lambda)
+    }
