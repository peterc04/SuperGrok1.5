+#if SG_TUNED_MB_PROJ_WGMMA
+// ── (FWD-GEMM half) Materialize ONE sample's five projection INPUTS X into the
+//    MbActs HBM region (the dW B-operand). Called in the P1 fwd window, AFTER
+//    mb_forward_sample populated this sample's smem and BEFORE the next sample
+//    overwrites it. `bg` is the sample's GLOBAL token-base (= b*kSeq); rows
+//    [bg, bg+kSeq) of every MbActs.X_* stream are written here. The values are:
+//      X_in   = xn   (mixer-norm out)  — RECOMPUTED from layer_in[li] via mixn_w
+//                                         (the scalar fwd threw xn away into dr).
+//      X_outp = y_gated = (y_scan + x_in·D)·silu(z)  — recomputed from retained
+//                                         a->y_scan / a->x_in / a->z / L.D
+//                                         (the SAME expression mb_mixer_fwd used).
+//      X_mlp  = h1n  (mlp-norm out)     — RECOMPUTED from a->h1 via mlpn_w.
+//      X_down = prod = silu(g_pre)·u_mlp — recomputed from retained a->g_pre/u_mlp.
+//    Every recompute is the IDENTICAL fp32 arithmetic the forward ran, so the
+//    bf16-rounded value stored is bit-equal to a bf16 reference of the oracle's X.
+//    Element-owned, no atomics, no cross-thread reduction → deterministic. ──
+__device__ __forceinline__ void mbtc_materialize_sample_x(
+        const MambaWeights& w, const MbActs& acts, int bg,
+        const MambaSampleSmem* sm) {
+    for (int li = 0; li < mb::kLayers; ++li) {
+        const MambaWeights::Layer& L = w.layer[li];
+        const MambaSampleSmem::LayerAct* a = &sm->act[li];
+        // X_in = xn = RMSNorm_mix(layer_in[li]) (mixn). r = mixn_r[s] (cached).
+        for (int idx = threadIdx.x; idx < mb::kSeq * mb::kD; idx += blockDim.x) {
+            const int s = idx / mb::kD, j = idx % mb::kD;
+            const float xr = sm->layer_in[li][s][j];
+            const float xn = xr * a->mixn_r[s] * L.mixn_w[j];   // RMSNorm fwd, no bias
+            acts.X_in[li][(int64_t)(bg + s) * mb::kD + j] = __float2bfloat16(xn);
+        }
+        // X_outp = y_gated[s,c] = (y_scan + x_in·D)·silu(z) — the out_proj input.
+        for (int idx = threadIdx.x; idx < mb::kSeq * mb::kDInner; idx += blockDim.x) {
+            const int s = idx / mb::kDInner, c = idx % mb::kDInner;
+            const float yv = a->y_scan[s][c] + a->x_in[s][c] * L.D[c];
+            const float yg = yv * mb_silu(a->z[s][c]);
+            acts.X_outp[li][(int64_t)(bg + s) * mb::kDInner + c] = __float2bfloat16(yg);
+        }
+        // X_mlp = h1n = RMSNorm_mlp(h1) (mlpn). r = mlpn_r[s] (cached).
+        for (int idx = threadIdx.x; idx < mb::kSeq * mb::kD; idx += blockDim.x) {
+            const int s = idx / mb::kD, j = idx % mb::kD;
+            const float h1n = a->h1[s][j] * a->mlpn_r[s] * L.mlpn_w[j];
+            acts.X_mlp[li][(int64_t)(bg + s) * mb::kD + j] = __float2bfloat16(h1n);
+        }
+        // X_down = prod = silu(g_pre)·u_mlp — the down_proj input.
+        for (int idx = threadIdx.x; idx < mb::kSeq * mb::kDff; idx += blockDim.x) {
+            const int s = idx / mb::kDff, o = idx % mb::kDff;
+            const float prod = mb_silu(a->g_pre[s][o]) * a->u_mlp[s][o];
+            acts.X_down[li][(int64_t)(bg + s) * mb::kDff + o] = __float2bfloat16(prod);
+        }
+    }
+}
