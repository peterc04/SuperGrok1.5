+    def test_emitted_source_stash_key_matches_swap_read_key():
+        """Phase C0.0 keying-bug guard — the key ``_variant_macros`` STASHES a
+        GENERATED (emitter/synth) source under MUST equal the key
+        ``build_jit``'s winner-swap READS, or the swap silently no-ops and a
+        generated winner ships a TEMPLATE build under its validated timing (the
+        #16/P0-3 false-green these gates exist to stop).
+
+        This was a real LATENT bug: ``_variant_macros`` stashed on the BARE
+        ``config_key`` while ``build_jit`` read the composite ``"<ckey>:synth"``
+        — the keys differed, so the swap could NEVER fire. Both sites now route
+        through the single-source-of-truth ``_emitted_source_key`` helper. This
+        test BEHAVIORALLY runs the emitter and asserts the actually-stashed key
+        is byte-identical to the swap-read key, so the two can never silently
+        drift apart again (a literal-only assertion would miss a helper that
+        computed different strings)."""
+        # Behavioral round-trip: run the emitter, recover the stashed key, and
+        # prove build_jit would read THAT key for a synth-origin winner.
+        try:
+            import jinja2  # noqa: F401
+        except ImportError:
+            # No jinja2 → the emitter path can't render; fall back to the pure
+            # contract check (the helper is the only key producer either way).
+            ck = "deadbeefdeadbeef"
+            assert _emitted_source_key(ck, ORIGIN_SYNTH) == f"{ck}:synth", \
+                "the composite key helper must produce '<ckey>:synth'"
+            return
+        td = Path(tempfile.mkdtemp())
+        try:
+            spec = BuildSpec(
+                optimizer="adamw", model="mamba", arch="sm_90a",
+                out_dir=td, enable_emitter=True)
+            sm90_dims = build_full_search_space()["sm_90"]["dims"][:3]
+            cfg = {d["name"]: d["values"][0] for d in sm90_dims}
+            _variant_macros(cfg, sm90_dims, "device", spec=spec)
+            ck = config_key(cfg)
+            # The key the emitter ACTUALLY stashed under.
+            stash_key = _emitted_source_key(ck, ORIGIN_SYNTH)
+            assert stash_key in spec._emitted_sources, (
+                f"emitter did not stash under the swap-read key {stash_key!r}; "
+                f"present keys: {list(spec._emitted_sources)}")
+            # The key build_jit's swap would READ for a synth-origin winner
+            # (won_ckey == ck). Computed via the SAME helper build_jit calls —
+            # asserting equality pins stash-key == swap-read-key by construction.
+            won_ckey = ck
+            swap_read_key = _emitted_source_key(won_ckey, ORIGIN_SYNTH)
+            assert stash_key == swap_read_key, (
+                f"STASH/SWAP KEY MISMATCH: emitter stashed {stash_key!r} but "
+                f"build_jit reads {swap_read_key!r} — the swap would silently "
+                f"no-op and ship a template under the generated winner's timing")
+            # And the bare config_key MUST NOT be the stash key (the exact
+            # pre-fix bug): a regression to the bare key would re-open the
+            # silent no-op.
+            assert ck not in spec._emitted_sources, (
+                "emitter stashed under the BARE config_key — build_jit reads "
+                "the composite key, so the swap would silently no-op")
+            # Cross-origin sanity: the polyhedral stash/read key is distinct
+            # from the synth one (no accidental collision between origins).
+            assert _emitted_source_key(ck, ORIGIN_POLYHEDRAL) != stash_key, \
+                "synth and polyhedral composite keys must not collide"
+        finally:
+            shutil.rmtree(td)
 
