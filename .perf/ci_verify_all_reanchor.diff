+def _phase5f_sm90_production(rep: Report) -> None:
+    """Pure-Python consistency check for the production sm_90 L3-REAL path."""
+    try:
+        from grokking_optimizers import dispatch as dp
+
+        # (1) fused_train_step must be callable.
+        if not callable(dp.fused_train_step):
+            rep.add(Check("5", "sm_90 fused_train_step callable",
+                          FAIL, "dispatch.fused_train_step is not callable"))
+            return
+        rep.add(Check("5", "sm_90 fused_train_step callable", PASS))
+
+        # (2) _FUSED_L3_REAL and _L3_WGMMA_CELLS must each be len 33.
+        n_l3_real = len(dp._FUSED_L3_REAL)
+        rep.add(Check("5", f"dispatch._FUSED_L3_REAL len 33",
+                      PASS if n_l3_real == 33 else FAIL,
+                      "" if n_l3_real == 33
+                      else f"got {n_l3_real}, want 33"))
+
+        n_wgmma = len(dp._L3_WGMMA_CELLS)
+        rep.add(Check("5", f"dispatch._L3_WGMMA_CELLS len 33",
+                      PASS if n_wgmma == 33 else FAIL,
+                      "" if n_wgmma == 33
+                      else f"got {n_wgmma}, want 33"))
+
+        # (3) For every (canonical_model, opt) in _FUSED_L3_REAL:
+        #     gemm_impl_for_cell == 'wgmma' AND has_l3_real == True.
+        # has_l3_real is called with arch=90 explicitly — this is a CPU-only
+        # check of the production sm_90 path; no GPU or detect_arch() needed.
+        bad_gemm: List[str] = []
+        bad_l3: List[str] = []
+        for (model, opt) in sorted(dp._FUSED_L3_REAL):
+            gemm = dp.gemm_impl_for_cell(model, opt, "bf16")
+            if gemm != "wgmma":
+                bad_gemm.append(f"{model}+{opt}={gemm!r}")
+            if not dp.has_l3_real(model, opt, arch=90):
+                bad_l3.append(f"{model}+{opt}")
+        rep.add(Check("5", "all _FUSED_L3_REAL cells gemm_impl=='wgmma'",
+                      PASS if not bad_gemm else FAIL,
+                      "" if not bad_gemm else f"{bad_gemm[:5]}"))
+        rep.add(Check("5", "all _FUSED_L3_REAL cells has_l3_real==True",
+                      PASS if not bad_l3 else FAIL,
+                      "" if not bad_l3 else f"{bad_l3[:5]}"))
+
+        # (4) All 7 SM90_REAL_TUS exist on disk.
+        miss = [p.name for p in SM90_REAL_TUS if not p.exists()]
+        rep.add(Check("5", f"sm_90 real TUs on disk ({len(SM90_REAL_TUS)})",
+                      PASS if not miss else FAIL,
+                      "" if not miss else f"missing: {miss}"))
+
+        # (5) Each *_real_adamw_tc_launcher.cu declares the entry-point function
+        #     and carries an `opt_id` switch.
+        launcher_tus = [p for p in SM90_REAL_TUS
+                        if p.name.endswith("_launcher.cu")]
+        bad_launcher: List[str] = []
+        for p in launcher_tus:
+            if not p.exists():
+                bad_launcher.append(f"{p.name} (missing)")
+                continue
+            text = p.read_text()
+            # Every launcher must have an opt_id switch dispatch.
+            if "switch" not in text or "opt_id" not in text:
+                bad_launcher.append(f"{p.name} (no opt_id switch)")
+        rep.add(Check("5", "sm_90 launchers have opt_id switch",
+                      PASS if not bad_launcher else FAIL,
+                      "" if not bad_launcher else f"{bad_launcher}"))
+
+    except Exception as exc:  # noqa: BLE001
+        rep.add(Check("5", "sm_90 production path consistency",
+                      FAIL, f"{type(exc).__name__}: {exc}"[:300]))
