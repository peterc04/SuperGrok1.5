+// ════════════════════════════════════════════════════════════════════════
+//  P1-EPILOGUE-FUSION wrappers (SG_TUNED_DEC_EPI_FUSE). Mirror the two fwd
+//  wrappers above EXACTLY (same engine, same DecGmemTileSrcA/B, same RING) —
+//  ONLY the out() accessor folds the post-loop scalar work in.  Compiled in only
+//  when the corresponding sub-knob is set; the OFF build never instantiates them
+//  (templates → zero codegen) → byte-identical PTX. ════════════════════════════
+#if SG_TUNED_DEC_EPI_FUSE_A
+// FOLD A: (fwd) qkv[M,Nout] = bf16( X@W^T + bias ).  SINGLE round of (acc + bias)
+// — vs the shipped post-loop's bf16(bf16(X@W^T) + bias) DOUBLE round. The engine
+// is byte-identical to dectc_gemm_fwd; only the bf16-output lambda adds bias[n0+n]
+// to the fp32 accumulator BEFORE the one __float2bfloat16 round. `bias` is the
+// per-output-column [Nout] fp32 bias (L.in_b). Absorbable-direction toward the
+// oracle bf(x@bf(w)^T + in_b); gate-arbitrated.
+template <int N>
+__device__ __forceinline__ void dectc_gemm_fwd_bias(
+        const __nv_bfloat16* __restrict__ X, const __nv_bfloat16* __restrict__ W,
+        __nv_bfloat16* __restrict__ Yout, const float* __restrict__ bias,
+        int Kin, int Nout,
+        __nv_bfloat16* sA, __nv_bfloat16* sB, unsigned long long* pipeBars = nullptr) {
+    const int k_steps = Kin / wgs::kWgmmaAtomK;
+    for (int n0 = 0; n0 < Nout; n0 += N) {
+        const int n_real = (Nout - n0) < N ? (Nout - n0) : N;
+        DecGmemTileSrcA srcA{X, Kin};
+        DecGmemTileSrcB srcB{W + (int64_t)n0 * Kin, Kin, Nout - n0};
+        auto out  = [&] (int m, int n, float v) {
+            Yout[(int64_t)m * Nout + n0 + n] = __float2bfloat16(v + bias[n0 + n]); };
+        tc_gemm_block_unpipelined<N, /*MaxAtomsM=*/kAtomsM>(
+            0, kAtomsM, n_real, k_steps, srcA, srcB, out, sA, sB, pipeBars SG_DEC_FINE_FWD);
+    }
+}
+#endif // SG_TUNED_DEC_EPI_FUSE_A
+
+#if SG_TUNED_DEC_EPI_FUSE_B
+// FOLD B: (fwd-f32 + ff0 epilogue) ff0[M,Nout] = X@W^T (fp32 accumulator v).
+// pre = v + ff0_b[n0+n]; ff0pre[m,j] = bf16(pre); X_gact[(g0+m),j] = bf16(gelu(pre)).
+// BYTE-IDENTICAL: v is the exact fp32 accumulator the standalone fp32 store
+// emitted, so pre is the SAME fp32 value sc.work[idx]+ff0_b[j] computed; both bf16
+// rounds are the post-loop's bit-for-bit. ff0pre uses LOCAL tile rows (sc.ff0pre,
+// row stride Nout); X_gact uses GLOBAL rows (acts.X_gact, row stride Nout, base
+// offset g0) — hence g0 + the two distinct row strides are passed explicitly.
+template <int N>
+__device__ __forceinline__ void dectc_gemm_fwd_f32_ff0fuse(
+        const __nv_bfloat16* __restrict__ X, const __nv_bfloat16* __restrict__ W,
+        __nv_bfloat16* __restrict__ ff0pre, __nv_bfloat16* __restrict__ Xgact,
+        const float* __restrict__ ff0_b, int g0, int Kin, int Nout,
+        __nv_bfloat16* sA, __nv_bfloat16* sB, unsigned long long* pipeBars = nullptr) {
+    const int k_steps = Kin / wgs::kWgmmaAtomK;
+    for (int n0 = 0; n0 < Nout; n0 += N) {
+        const int n_real = (Nout - n0) < N ? (Nout - n0) : N;
+        DecGmemTileSrcA srcA{X, Kin};
+        DecGmemTileSrcB srcB{W + (int64_t)n0 * Kin, Kin, Nout - n0};
+        auto out  = [&] (int m, int n, float v) {
+            const int j = n0 + n;
+            const float pre = v + ff0_b[j];
+            ff0pre[(int64_t)m * Nout + j]            = __float2bfloat16(pre);
+            Xgact [(int64_t)(g0 + m) * Nout + j]     = __float2bfloat16(dec_gelu(pre));
+        };
+        tc_gemm_block_unpipelined<N, /*MaxAtomsM=*/kAtomsM>(
+            0, kAtomsM, n_real, k_steps, srcA, srcB, out, sA, sB, pipeBars SG_DEC_FINE_FWD);
+    }
+}
+#endif // SG_TUNED_DEC_EPI_FUSE_B
