+#ifndef SG_TUNED_DEC_EPI_FUSE
+#define SG_TUNED_DEC_EPI_FUSE 0   // DEFAULT OFF → byte-identical PTX
+#endif
+#ifndef SG_TUNED_DEC_EPI_FUSE_A
+#define SG_TUNED_DEC_EPI_FUSE_A SG_TUNED_DEC_EPI_FUSE   // in_b fold (parity-bearing); revert alone via -D...=0
+#endif
+#ifndef SG_TUNED_DEC_EPI_FUSE_B
+#define SG_TUNED_DEC_EPI_FUSE_B SG_TUNED_DEC_EPI_FUSE   // ff0_b+gelu fold (byte-identical); revert alone via -D...=0
+#endif
