+# ───────────────────────────────────────────────────────────────────────────
+# Level-2 C0 (#27) — DEVICE-FRAGMENT emitter
+#
+# emit_fragment_source is the generative entry point for FUSION variants. It
+# emits a __device__ __forceinline__ Out-functor (a .cuh fragment) that the
+# persistent megakernel SPLICES IN via #include — NOT a __global__ kernel and
+# NOT an extern "C" host launcher. A whole-TU host-launched kernel (what
+# synthesize_kernel / emit_variant_source produce) is C2-illegal inside the
+# GridBarrier-coordinated 1-CTA/SM megakernel (it cannot invoke a host-launched
+# __global__ device-side); the only legal generated artifact is a device-
+# inlinable fragment dropped in as the engine's ``typename Out`` epilogue
+# accessor.
+#
+# The emit class is restricted to FOLD-ORDER-PRESERVING POINTWISE epilogue ops
+# over the post-wgmma-drain fp32 accumulator: a per-column bias add (out_b[n])
+# and a per-element residual add (Xin[m,n]). These are pure pointwise over the
+# SAME (row,col) index space the GEMM writes — no reduction, no reassociation,
+# no k-loop touch, no bf16-intermediate round — so the ascending-k bit-
+# determinism (C1) holds BY CONSTRUCTION and the folded write is the byte-
+# identical fp32 value at the same address as the separate-pass write. Any op
+# outside this class (a reduce node, a k-loop touch, a bf16-round fold) is
+# REJECTED at emit time (FragmentEmitError) so an illegal fusion can never
+# reach a build.
+# ───────────────────────────────────────────────────────────────────────────
+
+# The pointwise epilogue op kinds the fragment emitter is allowed to fold. Each
+# maps to a one-line C expression contribution added to the raw fp32 GEMM
+# accumulator ``v``. NOTHING that reassociates a sum or crosses the k-loop is
+# here — that is the whole point of the restriction (C1 ascending-k determinism
+# is preserved because the GEMM reduction itself is untouched; we only add a
+# pointwise term to its already-drained fp32 result).
+_FRAGMENT_FOLD_OPS: frozenset = frozenset({"bias_add", "residual_add"})
+
+# Op kinds that are CATEGORICALLY illegal in a device-fragment epilogue fold:
+# any reduction (reassociates the fp32 sum → C1 violation) or any op that would
+# require touching the contraction k-loop / a bf16 intermediate round (changes
+# the bf16-faithful result → fails the fp64/A-A-A gate). Listed explicitly so
+# the rejection is a named contract, not an accident of the allow-list.
+_FRAGMENT_FORBIDDEN_OPS: frozenset = frozenset({
+    "reduce", "scan", "gemm", "scatter", "gather", "layernorm", "softmax",
+})
+
+
+class FragmentEmitError(SynthCodegenError):
+    """Raised when an OpGraph cannot be lowered to a legal device fragment.
+
+    Distinct subclass of ``SynthCodegenError`` so the ``_variant_macros``
+    fall-through (which already catches the synth-error family) treats an
+    illegal-fold the same as any other emitter failure — it warns loudly and
+    drops back to the legacy macros-only / template path rather than shipping
+    an illegal fusion.
+    """
+
+
+def _fragment_validate_fold(opgraph: "OpGraph") -> List["OpNode"]:
+    """Assert ``opgraph`` is a pure fold-order-preserving POINTWISE epilogue.
+
+    Returns the topologically-ordered nodes on success; raises
+    ``FragmentEmitError`` if ANY node is a reduce / scan / gemm / scatter /
+    gather (a reassociating or k-loop-touching op) or an elementwise node whose
+    declared ``fold_op`` is not in ``_FRAGMENT_FOLD_OPS``. This is the
+    static-assert that makes C1 ascending-k bit-determinism hold by
+    construction: the emit class is bias-add + residual-add ONLY, so the GEMM
+    contraction is never re-ordered and no bf16 intermediate round is inserted.
+    """
+    if not isinstance(opgraph, OpGraph):
+        raise FragmentEmitError(
+            f"emit_fragment_source: opgraph must be an OpGraph, got "
+            f"{type(opgraph).__name__}")
+    nodes = opgraph.topological_order()
+    if not nodes:
+        raise FragmentEmitError(
+            "emit_fragment_source: empty OpGraph — nothing to fold")
+    for n in nodes:
+        if n.op_kind in _FRAGMENT_FORBIDDEN_OPS:
+            raise FragmentEmitError(
+                f"node {n.name!r} is op_kind={n.op_kind!r} — a reducing / "
+                f"k-loop-touching op is FORBIDDEN in a device-fragment "
+                f"epilogue fold (it would reassociate the fp32 sum or insert a "
+                f"bf16 round → C1 / fp64-gate violation). Only "
+                f"{sorted(_FRAGMENT_FOLD_OPS)} pointwise folds are legal.")
+        if n.op_kind != "elementwise":
+            raise FragmentEmitError(
+                f"node {n.name!r} has op_kind={n.op_kind!r}; the fragment "
+                f"emitter only lowers pointwise 'elementwise' fold nodes")
+        fold_op = str(n.attrs.get("fold_op", ""))
+        if fold_op not in _FRAGMENT_FOLD_OPS:
+            raise FragmentEmitError(
+                f"node {n.name!r} declares fold_op={fold_op!r}, not in the "
+                f"legal pointwise epilogue set {sorted(_FRAGMENT_FOLD_OPS)}")
+    return nodes
+
+
+def _emit_fragment_functor_cuda(opgraph: "OpGraph",
+                                arch: str,
+                                dtype: str,
+                                splice_name: str) -> str:
+    """Emit the __device__ __forceinline__ Out-functor body (string).
+
+    The functor matches the engine's ``typename Out`` accessor contract
+    (``operator()(int m, int n, float v) const`` — see the unpipelined GEMM
+    engine's out(m,n,v) in model_stage_decoder_tc.cuh) and folds the legal
+    pointwise terms into the raw fp32 GEMM accumulator ``v``:
+
+      * a ``residual_add`` node contributes ``__bfloat162float(Xin[off])`` (a
+        per-element bf16 residual, read at the SAME flat (row,col) address);
+      * a ``bias_add`` node contributes ``out_b[col]`` (a per-column fp32 bias).
+
+    The fold is written for VALID rows (``m < nrows``) only; padding rows of a
+    ragged last tile get the raw GEMM value ``v`` (byte-identical to the
+    separate-pass OFF path AND out-of-bounds-safe, since the residual buffer is
+    sized exactly [nrows, d] with no tile padding). This is the byte-for-byte
+    shape of the hand-authored SynthEpiR1 in the C0 MVP — the emitter
+    reproduces a known-good fragment, it does not invent a new one.
+    """
+    is_hip = (_synth_arch_vendor(arch) == "hip")
+    scalar_t, _, _ = _synth_dtype_triple(dtype, is_hip=is_hip)  # bf16 residual
+    nodes = _fragment_validate_fold(opgraph)
+    struct = f"SynthEpiR1_{_synth_sanitize(splice_name)}"
+    has_residual = any(
+        n.attrs.get("fold_op") == "residual_add" for n in nodes)
+    has_bias = any(n.attrs.get("fold_op") == "bias_add" for n in nodes)
+    # Build the fold expression as the byte-identical grouping of the hand
+    # pass: work[off] = v + (residual + bias). Parenthesise the added terms
+    # together so the fp32 grouping matches the separate-pass
+    # ``work[off] += residual + bias`` exactly.
+    terms: List[str] = []
+    if has_residual:
+        terms.append("__bfloat162float(Xin[off])")
+    if has_bias:
+        terms.append("out_b[col]")
+    if not terms:
+        raise FragmentEmitError(
+            "emit_fragment_source: no foldable term (need at least one of "
+            "residual_add / bias_add)")
+    added = " + ".join(terms)
+    fold_line = (f"work[off] = v + ({added});"
+                 if len(terms) > 1 else f"work[off] = v + {added};")
+    # The bf16 residual pointer is only declared when a residual_add is folded.
+    xin_field = (f"    const {scalar_t}* __restrict__ Xin;      "
+                 f"// per-element residual ([nrows, d])\n"
+                 if has_residual else "")
+    out_b_field = ("    const float* __restrict__         out_b;    "
+                   "// per-column bias ([d])\n" if has_bias else "")
+    fold_ops_present = ", ".join(
+        sorted({str(n.attrs.get("fold_op")) for n in nodes}))
+    return f"""// AUTO-GENERATED by emit_fragment_source (#27 Level-2 C0) — DO NOT EDIT
+// Device-FRAGMENT: a __device__ __forceinline__ Out-functor spliced into the
+// persistent megakernel via #include. NOT a __global__ kernel; NOT an
+// extern "C" host launcher (C2-illegal inside the 1-CTA/SM megakernel).
+// Splice: {splice_name}
+// Arch: {arch}, dtype: {dtype}, fold ops: {fold_ops_present}
+// Fold (pointwise, fold-order-preserving, C1-clean by construction):
+//   work[m*d+col] = v + (residual + bias)   for valid rows (m < nrows)
+//   work[m*d+col] = v                        for padding rows (OOB-safe)
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+
+template <int N>
+struct {struct} {{
+    float* __restrict__               work;     // GEMM fp32 output base ([kTileM, d])
+{xin_field}{out_b_field}    int                               d;        // = Nout (out_proj N == kD)
+    int                               nrows;    // valid rows in this tile
+    int                               col_base; // current n-tile global column (n0)
+    __device__ __forceinline__ void operator()(int m, int n, float v) const {{
+        const int col = col_base + n;
+        const long long off = (long long)m * d + col;
+        if (m < nrows) {fold_line}
+        else           work[off] = v;   // padding row: raw GEMM (== OFF path)
+    }}
+}};
+"""
+
+
+def emit_fragment_source(config: Dict[str, Any],
+                         dims: List[Dict[str, Any]],
+                         optimizer: str,
+                         arch: str,
+                         out_dir: Path,
+                         splice_name: str,
+                         opgraph: Optional["OpGraph"] = None,
+                         ) -> Tuple[Path, List[str]]:
+    """Emit a __device__ __forceinline__ epilogue-fusion FRAGMENT (.cuh).
+
+    This is the Level-2 C0 (#27) generative entry point. Unlike
+    ``emit_variant_source`` (which renders a whole __global__ + extern "C"
+    host launcher TU — C2-illegal inside the persistent megakernel), this emits
+    a device-inlinable Out-functor the megakernel splices in via #include.
+
+    Parameters
+    ----------
+    config, dims, optimizer, arch : as ``emit_variant_source`` (config/dims
+        supply the residual macros host code may still need; the FRAGMENT body
+        itself is geometry-independent — ``operator()`` takes the tile dims as
+        runtime args).
+    out_dir : directory the ``epi_<key>.cuh`` fragment is written to.
+    splice_name : the ckey-shaped name baked into the struct identifier so the
+        emitted functor is uniquely named per variant (no ODR clash across
+        coexisting candidate builds).
+    opgraph : the fold OpGraph to lower. Defaults to the C0 MVP r1 fold
+        (residual_add + bias_add) when None — the one provably bit-identical,
+        perf-positive epilogue fusion (the demonstration vehicle). The default
+        is built here so the FUSION origin has a working pattern end-to-end
+        without the caller having to assemble the OpGraph.
+
+    Returns
+    -------
+    (Path, residual_macros) — the emitted ``.cuh`` path (NEVER a ``.cu``) and
+    the host-side residual macros (same contract as ``emit_variant_source`` so
+    the ``_variant_macros`` call site is signature-compatible).
+
+    TODO (net-net progress beyond this skeleton): (1) generalise ``opgraph`` so
+    the fusion-pattern library (r1, r2 residual+bias; ff0 gelu) maps to per-site
+    operand descriptors instead of the single baked default; (2) wire the ViT /
+    Mamba twins behind their own SG_TUNED_*_EPI seams once the decoder coupling
+    is validated end-to-end (gate the expansion on the decoder verdict per the
+    spec); (3) emit the matching engine call wrapper (dectc_gemm_fwd_f32_epi_r1)
+    as a sibling fragment so the splice seam can #include both the functor AND
+    its caller from one generated source.
+    """
+    # The fp32-output epilogue stores RAW fp32 (no bf16 round on the out_proj
+    # fwd_f32 path), so the fragment's accumulator dtype is fp32; the residual
+    # it folds in is a bf16 tensor (read + up-converted per element). dtype here
+    # selects the residual scalar spelling (bf16) via _synth_dtype_triple.
+    dtype = "bf16"
+    if opgraph is None:
+        # C0 MVP default — the r1 residual+bias fold: the single fusion that is
+        # provably C1-clean (pure pointwise over the GEMM's (row,col) space, no
+        # reduction, no reassociation, no bf16 round) AND perf-positive (removes
+        # a full nrows*d smem write+read pass + one __syncthreads per layer).
+        opgraph = OpGraph(
+            inputs={
+                "v":     ("float", ()),
+                "Xin":   ("bf16", ()),
+                "out_b": ("float", ()),
+            },
+            nodes=[
+                OpNode(
+                    op_kind="elementwise",
+                    name="r1_residual",
+                    inputs=["v", "Xin"],
+                    output="t0",
+                    attrs={"fold_op": "residual_add",
+                           "expr": "v + __bfloat162float(Xin)"},
+                ),
+                OpNode(
+                    op_kind="elementwise",
+                    name="r1_bias",
+                    inputs=["t0", "out_b"],
+                    output="r1",
+                    attrs={"fold_op": "bias_add",
+                           "expr": "t0 + out_b"},
+                ),
+            ],
+            output="r1",
+        )
+    # Legality check + lowering. _emit_fragment_functor_cuda re-runs
+    # _fragment_validate_fold so an illegal OpGraph is rejected before any file
