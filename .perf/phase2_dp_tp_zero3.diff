+def _build_local_shard(spec: ModelSpec, cfg: ParallelConfig, device: str,
+                       seed: int = 42) -> List[torch.nn.Parameter]:
     """Allocate this rank's *local* parameter shard as a flat list of params.
 
     We do NOT instantiate the full 7B model on one rank — that would OOM. We
     allocate only the TP×PP-sharded slice (``shard_param_count``) as a handful
     of large flat parameters, which is enough to exercise the ZeRO-3 collectives
     and the fused-step adapter at realistic per-GPU memory.
+
+    ``seed`` is used for a deterministic init (torch.manual_seed before each
+    allocation).  Using the SAME seed on every DP rank is the DP-2 cross-rank
+    param-identity invariant precondition: after ZeRO-3 reduce/all-gather, all
+    DP replicas must hold identical params — and that is only guaranteed (by the
+    math) if they START from the same weights.  Independent randn per rank would
+    make the post-step params differ legitimately across DP replicas even when the
+    ZeRO-3 collectives are correct.
     """
     per_rank = shard_param_count(spec, cfg)
     # Split into ~chunks of <=2**28 elements to keep individual allocations sane.
     chunk = 1 << 26
     params: List[torch.nn.Parameter] = []
     remaining = per_rank
+    idx = 0
     while remaining > 0:
         n = min(chunk, remaining)
+        # Deterministic same-seed init: every DP replica must start with the
+        # same weights so the post-step cross-DP param-identity assert is valid.
+        torch.manual_seed(seed + idx)
         p = torch.nn.Parameter(torch.randn(n, device=device, dtype=torch.bfloat16))
+        torch.manual_seed(seed + idx + 1000)
         p.grad = torch.randn_like(p)
         params.append(p)
         remaining -= n
+        idx += 1
     return params
 
 
