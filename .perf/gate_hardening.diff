+def _csa_softmax_pool(x_sorted, compress_w, stride, win, Nc):
+    """Softmax-weighted strided window pool of x_sorted → [Nc, d]. Independent
+    transcription of supergrok2.py:437-447 (the CSA compress pool) — NOT a copy of
+    sg2_kernel_mirror.softmax_pool_csa (which is the KERNEL mirror). Both must of
+    course agree; that they are derived separately is the point of de-mirroring."""
+    N, d = x_sorted.shape
+    out = np.zeros((Nc, d), dtype=np.float64)
+    cw = np.asarray(compress_w, dtype=np.float64)
+    for j in range(Nc):
+        base = j * stride
+        taps = [base + wq for wq in range(win) if base + wq < N]
+        if not taps:
+            continue
+        logits = np.array([cw[t - base] for t in taps], dtype=np.float64)
+        e = np.exp(logits - logits.max())
+        wts = e / e.sum()
+        out[j] = (wts[:, None] * x_sorted[taps]).sum(0)
+    return out
+
