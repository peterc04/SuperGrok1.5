+def test_sg11_gate_oracle_operand_is_momentum_not_mu():
+    """OPERAND ANCHOR (oracle de-mirror, RG / oracle_trust_audit): pin the SG11 gate
+    oracle's 2nd cosine operand to MOMENTUM via a LITERAL closed-form case — independent
+    of both same-file twins (_sg11_gate_oracle_fp64 and _sg11_gate_mirror_fp32 are an
+    fp64/fp32 + naive/tree pair that BOTH hardcode `momentum`; the canonical refs the
+    docstrings point at, sg11_gate_ref / _cosine_gate_ref, do NOT exist anywhere in the
+    repo — so a co-edit swapping the operand to `mu` in BOTH twins would pass
+    test_sg11_cosine_gate_matches_fp64_oracle silently). Here we build grad + a momentum
+    vector + a DISTINCT mu vector chosen so cos(grad,momentum) != cos(grad,mu), hand-
+    compute sigmoid(gate_temp·cos(grad,momentum)) from a LITERAL, and assert the oracle
+    equals it AND DIFFERS from sigmoid(gate_temp·cos(grad,mu)). A swap to the cos(grad,mu)
+    operand (the historic SG11 bug) FAILS this by construction."""
+    gate_temp = 5.0
+    # grad ∥ e0; momentum has cos(grad,momentum)=1/√2; mu has cos(grad,mu)=−1/√2.
+    grad = torch.tensor([1.0, 0.0, 0.0, 0.0], dtype=torch.float64)
+    momentum = torch.tensor([1.0, 1.0, 0.0, 0.0], dtype=torch.float64)  # cos = 1/√2
+    mu = torch.tensor([-1.0, 0.0, 1.0, 0.0], dtype=torch.float64)        # cos = −1/√2
+    cos_mom = 1.0 / math.sqrt(2.0)
+    cos_mu = -1.0 / math.sqrt(2.0)
+    # LITERAL expected gate (not via the oracle's own helper) for the MOMENTUM operand.
+    expect_mom = 1.0 / (1.0 + math.exp(-gate_temp * cos_mom))
+    expect_mu = 1.0 / (1.0 + math.exp(-gate_temp * cos_mu))
+    # the two operands MUST give materially different gates (else the anchor is vacuous).
+    assert abs(expect_mom - expect_mu) > 0.5, "operand choice not discriminating — fix case"
+    got = _sg11_gate_oracle_fp64(grad, momentum, gate_temp=gate_temp)
