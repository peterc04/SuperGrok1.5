+//  sizer↔carve DISAGREEMENT (a carve advance not gated to match the host size).
+//  Routing BOTH the host term and the kernel carve through THIS ONE function makes
+//  the agreement structural — they cannot drift because there is one source.
+// ════════════════════════════════════════════════════════════════════════
+#ifndef SG_TUNED_MB_PROJ_WGMMA
+#define SG_TUNED_MB_PROJ_WGMMA 0
+#endif
