+// The TOTAL extra float workspace the M0 projection-wgmma path needs (the MbActs
+// HBM acts region for the dW operands + the bf16 projection weight cache for the
+// fwd GEMM B-operand), in FLOAT units. ZERO when the gate is OFF so the host
+// workspace size + the kernel carve are BOTH byte-identical to the scalar path.
+// This is the ONE function both mb_tc_workspace_floats (host) and the kernel's
+// pointer carve call — the sizer↔carve agreement is structural (cannot drift).
+__host__ __device__ __forceinline__ int64_t mb_proj_wgmma_floats(int T) {
+#if SG_TUNED_MB_PROJ_WGMMA
+    return mb_proj_acts_floats(T)     // MbActs: 4 X-streams + 5 dY-streams, T tokens
+         + mb_proj_wbf_floats();      // bf16 projection-weight cache (5 weights × layers)
+#else
+    (void)T;
+    return 0;
+#endif
+}
