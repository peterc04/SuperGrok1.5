+def _macro_present_in_kernels(macro: str) -> bool:
+    """True iff a committed kernel exposes ``macro`` as a real tuning knob —
+    either it ``#ifndef``-guards it (a tunable default the autotuner may
+    override) OR it reads it via ``#ifdef``/``#if``.
+
+    The robust-skip liveness predicate for RG3: when one of the registered new
+    structural levers (``vit_p1_subtile_s`` / ``dec_fwd_pipe`` /
+    ``dec_fwd_stages``) is ABSENT from a given checkout (a partial knob set — a
+    guard not yet landed or reverted), this returns False and the dim is
+    consequently treated as DEAD by :func:`_is_dead_dim` (a macro no kernel
+    reads), so :func:`_pin_dead_dims` PINS it to its first value — the in-source
+    #ifndef default the per-arch builder leads with — i.e. ×1 at a byte-identical
+    value. The sweep does NOT break; the absent knob just stops being explored
+    while the present knobs keep sweeping. When no source tree is visible
+    (installed wheel) every macro is treated as present so a no-source build
+    keeps its full registered space (the caller already falls back to the LIVE
+    floor in that degenerate case).
+
+    NB present-but-DEAD (a macro guarded by a kernel yet read by no ``#ifdef``)
+    is still handled by the SAME pin path; this predicate only distinguishes a
+    TRULY-ABSENT macro so the self-test can assert the partial-set skip directly
+    rather than relying on the broader source scan.
+    """
+    guarded = _kernel_ifndef_macros()
+    consumed = _kernel_source_macros()
+    if not guarded and not consumed:
+        return True  # no source tree visible — don't prune the registered space
+    if macro in guarded or macro in consumed:
+        return True
+    # A tuple dim expands to per-component macros (SG_TUNED_CLUSTER_SHAPE_0…);
+    # treat the base as present if any derived component is guarded/consumed.
+    return any(t == macro or t.startswith(macro + "_")
+               for t in (guarded | consumed))
+
