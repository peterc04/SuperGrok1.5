+    def test_new_structural_knobs_registered_and_swept():
+        """RG3 — the NEW committed structural perf levers are registered in the
+        sm_90 search space as SWEPT dims (not auto-pinned to ×1), with the
+        in-source #ifndef default LEADING each value list (byte-identical
+        canonical build), and the kernel's static_assert range respected.
+
+        This is the standing 'new -D knob is explored' guard: before RG3 these
+        knobs were DISCOVERED-and-PINNED by _auto_derived_dims (×1), so the
+        front-load autotuner saw them but never explored them. The assertion
+        fails loudly if a future edit reverts one back to a single value (the
+        coverage would silently regress to the pre-RG3 blind spot)."""
+        space = load_embedded_search_space()
+        dims = {d["name"]: d for d in space["sm_90"]["dims"]}
+        # Macro guards must be present in the committed kernel sources for these
+        # dims to be live (the robust-skip prunes them if absent). On the repo
+        # checkout the guards ARE present, so each dim is swept.
+        expect = {
+            # name              first==default   full swept set (order matters)
+            "vit_p1_subtile_s": (64, [64, 32, 16, 8]),
+            "dec_fwd_pipe":     (1,  [1, 0]),
+            "dec_fwd_stages":   (4,  [4, 2, 3]),
+            # tile_m was already a swept dim (#12); RG3 confirms the decoder
+            # {64,128,256} applicability is registered (default 128 leads).
+            "tile_m":           (128, [128, 64, 256]),
