ninja_required_version = 1.3
cxx = g++-cached
nvcc = /workspace/.local/bin/sccache /usr/local/cuda-12.4/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=grokking_compiled_adamw_decoder_sm_90_pgo_instrument -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/workspace/SuperGrok1.5/csrc/bindings -I/workspace/SuperGrok1.5 -I/workspace/SuperGrok1.5/third_party/cutlass/include -I/workspace/SuperGrok1.5/third_party/cutlass/tools/util/include -isystem /usr/local/lib/python3.11/dist-packages/torch/include -isystem /usr/local/lib/python3.11/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/local/lib/python3.11/dist-packages/torch/include/TH -isystem /usr/local/lib/python3.11/dist-packages/torch/include/THC -isystem /usr/local/cuda-12.4/include -isystem /usr/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17 -O3 -std=c++17 -fPIC -fno-semantic-interposition -fvisibility=hidden -fdata-sections -ffunction-sections -fno-math-errno -fno-trapping-math -fomit-frame-pointer -funroll-loops -march=native -mtune=native -DWITH_CUDA -ggdb -DSG_BUILD_OPTIMIZER_ADAMW=1 -DSG_BUILD_MODEL_DECODER=1 -DSG_BUILD_ARCH_SM90=1 -DSG_VERBOSE=1 -fprofile-generate=/workspace/SuperGrok1.5/build/compiled/pgo_profile -fprofile-update=atomic
post_cflags = 
cuda_cflags = -ccbin cc -DTORCH_EXTENSION_NAME=grokking_compiled_adamw_decoder_sm_90_pgo_instrument -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -I/workspace/SuperGrok1.5/csrc/bindings -I/workspace/SuperGrok1.5 -I/workspace/SuperGrok1.5/third_party/cutlass/include -I/workspace/SuperGrok1.5/third_party/cutlass/tools/util/include -isystem /usr/local/lib/python3.11/dist-packages/torch/include -isystem /usr/local/lib/python3.11/dist-packages/torch/include/torch/csrc/api/include -isystem /usr/local/lib/python3.11/dist-packages/torch/include/TH -isystem /usr/local/lib/python3.11/dist-packages/torch/include/THC -isystem /usr/local/cuda-12.4/include -isystem /usr/include/python3.11 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_90a,code=sm_90a --compiler-options '-fPIC' -O3 -std=c++17 -DWITH_CUDA --expt-relaxed-constexpr -Xfatbin -compress-all -Xptxas --opt-level=3 -Xptxas -v -Xptxas --warn-on-spills --extra-device-vectorization -Xcompiler -fPIC -Xcompiler -fno-strict-aliasing -Xnvlink --suppress-stack-size-warning --resource-usage --default-stream per-thread -gencode=arch=compute_90a,code=sm_90a -gencode=arch=compute_90,code=compute_90 -lineinfo --generate-line-info --source-in-ptx -DWITH_CUTLASS -DCUTLASS_NVCC_ARCHS=90a -DCUTLASS_NVCC_ARCHS_SUPPORTED=90a -DCUDA_TMA_ENABLED=1 -DCUDA_WGMMA_ENABLED=1 -DCUDA_CLUSTER_ENABLED=1 -DCUDA_FP8_ENABLED=1 -DCUDA_FORCE_CDP1_IF_SUPPORTED -DSG_BUILD_OPTIMIZER_ADAMW=1 -DSG_BUILD_MODEL_DECODER=1 -DSG_BUILD_ARCH_SM90=1 -DSG_VERBOSE=1 -DNDEBUG -Xcompiler -fprofile-generate=/workspace/SuperGrok1.5/build/compiled/pgo_profile -Xcompiler -fprofile-update=atomic -Xptxas --register-usage-level=10 -Xptxas --def-load-cache=ca -Xptxas --def-store-cache=wb --threads 8 --diag-suppress=20012,20013
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -Wl,--as-needed -Wl,--gc-sections -Wl,-O3 -fprofile-generate=/workspace/SuperGrok1.5/build/compiled/pgo_profile -L/usr/local/lib/python3.11/dist-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda-12.4/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build bindings.o: compile /workspace/SuperGrok1.5/csrc/bindings/bindings.cpp
build dispatch.o: compile /workspace/SuperGrok1.5/csrc/bindings/dispatch.cpp
build mega_decoder_real_adamw_tc_launcher.cuda.o: cuda_compile /workspace/SuperGrok1.5/csrc/fused/sm_90/mega_decoder_real_adamw_tc_launcher.cu
build mega_mamba_real_adamw_tc_launcher.cuda.o: cuda_compile /workspace/SuperGrok1.5/csrc/fused/sm_90/mega_mamba_real_adamw_tc_launcher.cu
build mega_vit_real_adamw_tc_launcher.cuda.o: cuda_compile /workspace/SuperGrok1.5/csrc/fused/sm_90/mega_vit_real_adamw_tc_launcher.cu
build sg2_meta_tail.cuda.o: cuda_compile /workspace/SuperGrok1.5/csrc/fused/sm_90/sg2_meta_tail.cu



build grokking_compiled_adamw_decoder_sm_90_pgo_instrument.so: link bindings.o dispatch.o mega_decoder_real_adamw_tc_launcher.cuda.o mega_mamba_real_adamw_tc_launcher.cuda.o mega_vit_real_adamw_tc_launcher.cuda.o sg2_meta_tail.cuda.o

default grokking_compiled_adamw_decoder_sm_90_pgo_instrument.so
