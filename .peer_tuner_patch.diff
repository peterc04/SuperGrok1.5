+# Repo root, anchored to this file. The .cu/.cuh sources use repo-root-relative
+# quoted includes (e.g. #include "grokking_optimizers/kernels/sm_90/adamw_sm90.cuh"
+# and "csrc/fused/sm_90/fused_megakernel.cuh"). torch.utils.cpp_extension emits
+# its ninja build file into a TEMP build dir and runs ninja FROM that dir, so a
+# relative "-I." resolves to the temp dir — not the repo root — and every such
+# include fails to resolve. Anchor all in-tree include dirs to _HERE so the
+# `pip install -e .` build matches the standalone `scripts/compile_to_object.sh`
+# gate (which cd's to ROOT before using -I.).
+_HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def _abs_incl(dirs):
+    """Absolutize in-tree include dirs against the repo root (see _HERE)."""
+    return [d if os.path.isabs(d) else os.path.join(_HERE, d) for d in dirs]
+
+
+# torch.utils.cpp_extension injects these four NO_HALF/NO_BFLOAT16 flags into
+# every nvcc compile (its module-level COMMON_NVCC_FLAGS). They disable the
+# implicit __half/__nv_bfloat16 <-> float conversion operators to dodge
+# ambiguity with torch's own c10::Half in TUs that mix both. Our device kernels
+# use raw CUDA __half/__nv_bfloat16 and rely on those conversions throughout
+# (decoder/vit/mamba/attention cast helpers, mamba_scan_adapter, etc.). The
+# in-repo gate (scripts/compile_to_object.sh) compiles WITHOUT these flags — so
+# the whole "33/33 nvcc -c OK" device-code validation was done in the
+# conversions-enabled regime the source targets. Strip them here so the
+# `pip install -e .` build matches that validated regime. nvcc-only: the .cpp
+# host TUs (bindings/dispatch) are compiled by the host compiler and unaffected.
+import torch.utils.cpp_extension as _cppext  # noqa: E402
+
+for _no_conv_flag in (
+    "-D__CUDA_NO_HALF_OPERATORS__",
+    "-D__CUDA_NO_HALF_CONVERSIONS__",
+    "-D__CUDA_NO_BFLOAT16_CONVERSIONS__",
+    "-D__CUDA_NO_HALF2_OPERATORS__",
+):
+    while _no_conv_flag in _cppext.COMMON_NVCC_FLAGS:
+        _cppext.COMMON_NVCC_FLAGS.remove(_no_conv_flag)
+
