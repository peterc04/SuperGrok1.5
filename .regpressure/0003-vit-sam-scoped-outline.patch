+// ════════════════════════════════════════════════════════════════════════
+//  SAM-cell-scoped OUT-OF-LINE tile shims (reg-pressure campaign C2; the
+//  decoder/mamba twin). The SAM-coupled cells (LookSAM/SG11/SG15/SG2) inline
+//  the heavy tile fwd+bwd TWICE (P1 + P2.4) -> ~15-18 KB hot-loop spills at
+//  the 255-reg ceiling. Routing BOTH their passes through these __noinline__
+//  shims shares ONE out-of-line frame; the single-pass cells keep the inline
+//  bodies (allocation byte-identical -- SASS-verified on the decoder twin).
+//  Math identical; warpgroup-uniform call.
+// ════════════════════════════════════════════════════════════════════════
+__device__ __noinline__ float vittc_forward_tile_outlined(
+        const VitWeights& w, int g0, int nrows, const VitActs& acts,
+        const VitTileScratch& sc, const float* __restrict__ patches,
+        const int* __restrict__ tgt_ids,
+        __nv_bfloat16* sA, __nv_bfloat16* sB, float* red) {
+    return vittc_forward_tile(w, g0, nrows, acts, sc, patches, tgt_ids, sA, sB, red);
+}
+__device__ __noinline__ void vittc_backward_tile_outlined(
+        const VitWeights& w, int g0, int nrows, int B, const VitActs& acts,
+        const VitTileScratch& sc, const int* __restrict__ tgt_ids,
+        float* __restrict__ lnvec, float* __restrict__ work2,
+        __nv_bfloat16* sA, __nv_bfloat16* sB, float* red) {
+    vittc_backward_tile(w, g0, nrows, B, acts, sc, tgt_ids, lnvec, work2, sA, sB, red);
+}
+
 // ════════════════════════════════════════════════════════════════════════
 //  P2 — OUTPUT-STATIONARY dW. Each of the 10 weight matrices (patch_proj +
 //  in/out/ff0/ff2 ×L + head) dW = dYᵀ @ X is split into 64×N output tiles;
