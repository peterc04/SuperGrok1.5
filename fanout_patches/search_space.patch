+def _kernel_ifndef_macros() -> frozenset:
+    """Auto-detect every ``#ifndef SG_TUNED_X`` guard the committed kernels
+    expose. A kernel that wants to be tunable wraps its default in::
+
+        #ifndef SG_TUNED_FOO
+        #define SG_TUNED_FOO <default>
+        #endif
+
+    so the autotuner can override the default with ``-DSG_TUNED_FOO=VAL``.
+    This returns the set of macro tokens guarded that way, which lets the
+    search-space builder AUTO-ADD a tuning dim for any knob a kernel newly
+    exposes even when no hand-written ``_dim(...)`` declares it — the space
+    self-configures to the kernels rather than waiting on a manual edit here.
+
+    Lines that are pure ``//`` comments are skipped so a commented-out guard
+    in a kernel doesn't spuriously inflate the space. Cached; returns an empty
+    set when no source tree is visible (installed wheel without kernels/).
+    """
+    global _KERNEL_IFNDEF_CACHE
+    if _KERNEL_IFNDEF_CACHE is not None:
+        return _KERNEL_IFNDEF_CACHE
+    import re as _re
+    roots = [REPO_ROOT / "csrc", REPO_ROOT / "grokking_optimizers" / "kernels"]
+    # Anchored at line start (after optional whitespace): ``#ifndef SG_TUNED_X``.
+    pat = _re.compile(r"^\s*#\s*ifndef\s+(SG_TUNED_[A-Z0-9_]+)")
+    exts = {".cu", ".cuh", ".h", ".hpp", ".hip", ".cpp", ".cc", ".cxx"}
+    found: set = set()
+    for root in roots:
+        if not root.exists():
+            continue
+        for p in root.rglob("*"):
+            if p.suffix not in exts:
+                continue
+            try:
+                text = p.read_text(errors="ignore")
+            except OSError:
+                continue
+            for line in text.splitlines():
+                stripped = line.lstrip()
+                if stripped.startswith("//"):
+                    continue  # comment-only line — not a live guard
+                m = pat.match(line)
+                if m:
+                    found.add(m.group(1))
+    _KERNEL_IFNDEF_CACHE = frozenset(found)
+    return _KERNEL_IFNDEF_CACHE
+
+
+def _macro_has_explicit_dim(macro: str, dims: List[Dict[str, Any]]) -> bool:
+    """True if ``macro`` (or a derived ``macro_*`` variant, e.g. the
+    per-component ``SG_TUNED_CLUSTER_SHAPE_0`` a tuple dim expands to) is
+    already declared by some hand-written dim in ``dims``."""
+    for d in dims:
+        dm = d.get("macro")
+        if dm and (dm == macro or macro.startswith(dm + "_")):
+            return True
+    return False
+
+
+def _macro_to_dim_name(macro: str) -> str:
+    """Derive a stable dim ``name`` from an ``SG_TUNED_X`` macro token —
+    ``SG_TUNED_PIPE_DEPTH`` -> ``pipe_depth``. Lower-cased, prefix stripped."""
+    base = macro[len("SG_TUNED_"):] if macro.startswith("SG_TUNED_") else macro
+    return base.lower()
+
+
+def _auto_derived_dims(dims: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """Return default dims for every ``#ifndef SG_TUNED_*`` guard the kernels
+    expose that has NO explicit dim in ``dims``.
+
+    This is the self-configuring half of the search space: a kernel that adds a
+    new ``#ifndef SG_TUNED_FOO`` knob gets a 2-value tuning dim auto-swept with
+    zero edits here. Hand-written dims always WIN — they're treated as
+    overrides (richer value lists, custom ``applies_to``/``kind``), so the
+    explicit GEMM/pipe/etc. specs below are unaffected. Auto dims default to a
+    device-only ``-DSG_TUNED_FOO=VAL`` macro over ``_AUTO_DERIVED_DIM_VALUES``.
+    """
+    guarded = _kernel_ifndef_macros()
+    if not guarded:
+        return []
+    extra: List[Dict[str, Any]] = []
+    seen_names = {d.get("name") for d in dims}
+    for macro in sorted(guarded):
+        if _macro_has_explicit_dim(macro, dims):
+            continue
+        name = _macro_to_dim_name(macro)
+        if name in seen_names:
+            continue
+        seen_names.add(name)
+        extra.append(_dim(name, "int", list(_AUTO_DERIVED_DIM_VALUES),
+                          macro, ["device"]))
+    return extra
+
+
+def _with_auto_dims(dims: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
+    """Append auto-derived dims (for kernel ``#ifndef`` knobs lacking an
+    explicit spec) to a hand-written dim list, in place, and return it."""
+    dims.extend(_auto_derived_dims(dims))
+    return dims
+
