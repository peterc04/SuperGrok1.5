+def _entry_winner_config(cache: CompileCache,
+                         entry: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    """Return the WINNER config dict for a cache entry, or None.
+
+    Prefers the entry's chosen ``tuned_config`` (the config that was actually
+    selected + shipped). Falls back to the fastest recorded trial — from the
+    in-memory ``bayesian_trials`` list if present, else the .jsonl sidecar
+    pointed at by ``trial_log_path`` (v4 strips the in-memory list before
+    writing the main JSON, so cross-process warm-start must read the sidecar).
+    Best-effort: any read error yields None.
+    """
+    tuned = entry.get("tuned_config")
+    if isinstance(tuned, dict) and tuned:
+        return tuned
+    trials = entry.get("bayesian_trials") or []
+    if not trials:
+        tlp = entry.get("trial_log_path")
+        if tlp and cache.path is not None:
+            try:
+                trials = _read_trial_log_records(cache.path.parent / tlp)
+            except Exception as _swexc:
+                _debug_swallow('_entry_winner_config', _swexc)
+                trials = []
+    best_cfg: Optional[Dict[str, Any]] = None
+    best_ms = math.inf
+    for t in trials:
+        ms = t.get("timing_ms")
+        cfg = t.get("config")
+        if ms is None or not isinstance(cfg, dict):
+            continue
+        try:
+            ms_f = float(ms)
+        except (TypeError, ValueError):
+            continue
+        if math.isfinite(ms_f) and ms_f < best_ms:
+            best_ms = ms_f
+            best_cfg = cfg
+    return best_cfg
+
+
+def _warm_start_configs(spec: BuildSpec,
+                        cache: CompileCache) -> List[Dict[str, Any]]:
+    """Transfer learning, built on the CACHE — warm-start config seeds.
+
+    When tuning ``(optimizer, model, arch)`` with no exact cache hit, gather
+    the WINNER config from the NEAREST already-tuned neighbours so the
+    Bayesian search can re-measure them on the real target before free TPE
+    sampling. Two neighbour rings (the exact tuple is always skipped; the
+    same model+arch / different optimizer ring is handled separately by
+    ``_collect_sibling_trials`` as ``add_trial`` seeds):
+
+      ring 1 — SAME model, DIFFERENT arch  (same kernel, other silicon)
+      ring 2 — SAME arch,  DIFFERENT optimizer/model (same silicon)
+
+    Ring 1 is listed first because a config tuned for the same kernel tends
+    to transfer better across silicon than a config tuned for a different
+    kernel on the same silicon. Duplicates (by config signature) are dropped,
+    ring 1 winning ties. Returns ``[]`` when no neighbour exists — the caller
+    then degrades to a clean cold-start. Read-only over the cache; never
+    mutates cache state or correctness.
+    """
+    entries = cache._data.get("entries", {})
+    if not entries:
+        return []
+    self_key = cache.key(spec.optimizer, spec.model, spec.arch)
+    ring1: List[Dict[str, Any]] = []  # same model, diff arch
+    ring2: List[Dict[str, Any]] = []  # same arch, diff optimizer/model
+    for key, entry in entries.items():
+        if key == self_key or not isinstance(entry, dict):
+            continue
+        # Cache keys are "<opt>/<model>/<arch>"; split from the right so a
+        # model name containing '/' (defensive) still parses arch+model.
+        parts = key.split("/")
+        if len(parts) < 3:
+            continue
+        k_arch = parts[-1]
+        k_model = parts[-2]
+        same_model = (k_model == spec.model)
+        same_arch = (k_arch == spec.arch)
+        if same_model and same_arch:
+            continue  # exact (opt-sibling) — owned by _collect_sibling_trials
+        cfg = _entry_winner_config(cache, entry)
+        if not cfg:
+            continue
+        if same_model and not same_arch:
+            ring1.append(cfg)
+        elif same_arch and not same_model:
+            ring2.append(cfg)
+    out: List[Dict[str, Any]] = []
+    seen: set = set()
+    for cfg in ring1 + ring2:
+        try:
+            sig = tuple(sorted(
+                (k, tuple(v) if isinstance(v, list) else v)
+                for k, v in cfg.items()))
+        except Exception as _swexc:
+            _debug_swallow('_warm_start_configs', _swexc)
+            continue
+        if sig in seen:
+            continue
+        seen.add(sig)
+        out.append(cfg)
+    return out
+
