+# Example "toy" project demonstrating that grokking_optimizers/compile.py is
+# plug-and-play for an arbitrary project via config only — no code changes.
+#
+# This config drives compile.py with a foreign optimizer (`toy_saxpy`), a
+# foreign model (`toy`), a custom macro prefix / Python package, a custom
+# source layout (including a dedicated fused-kernel root), a config-extensible
+# optimizer-class registry, and a project-supplied CUTLASS include dir.
+#
+# Resolve & validate it from Python with, e.g.:
+#
+#     import grokking_optimizers.compile as C
+#     cfg = C._load_toml_file(
+#         __import__("pathlib").Path(
+#             "examples/toy_tune_project/compile_config.toml"))
+#     merged = C._deep_merge(C._DEFAULT_PROJECT_CONFIG, cfg)  # or load_config()
+#     spec = C.BuildSpec(optimizer="toy_saxpy", model="toy",
+#                        arch="sm_90a",
+#                        out_dir=__import__("pathlib").Path("/tmp/toy"))
+#     C.apply_to_buildspec(spec, merged)
+#     C._validate(spec)   # passes — no ValueError
+
+[project]
+name           = "toy_tune"
+version        = "0.1.0"
+# Custom -D macro namespace. compile.py emits e.g. -DTOY_OPTIMIZER_TOY_SAXPY=1
+# and -DTOY_STRICT_MATH=1 (strict-math oracle) instead of leaking SG_*.
+macro_prefix   = "TOY_"
+# Worker / timing / validation subprocesses import the optimizer class from
+# this package; the JIT/AOT module name becomes toy_kernels_compiled_*.
+python_package = "toy_kernels"
+namespace      = "toy::kernels"
+fused_op_template = "torch.ops.toy_kernels.fused_{opt_lower}_step"
+
+# Config-extensible optimizer-class registry: maps the short name used on the
+# CLI / BuildSpec to the importable class string. Without this entry,
+# _opt_class_for("toy_saxpy") would KeyError against the built-in OPT_CLASS.
+[project.optimizer_classes]
+toy_saxpy = "toy_kernels.ToySaxpy"
+
+# The same lists the CLI `choices=` read via _resolve_enabled_* — _validate()
+# accepts these foreign names IN ADDITION to the built-in grokking optimizers.
+[optimizers]
+enabled = ["toy_saxpy"]
+
+[models]
+enabled = ["toy"]
+
+[archs]
+default = "sm_90a"
+
+[sources]
+# Custom per-vendor source tree (compile.py probes <root>/<arch> too).
+cuda_root       = "src/cuda"
+hip_root        = "src/hip"
+pallas_root     = ""
+bindings_dir    = "src/bindings"
+algorithms_dir  = "src/algorithms"
+tuned_header_path = "src/algorithms/tuned_configs.h"
+# Dedicated fused-kernel root. _resolve_sources probes both
+# <fused_root>/<arch-subdir-leaf> (e.g. src/fused/sm_90 for arch sm_90a — the
+# leaf matches the ArchEntry.subdir convention) and <fused_root> itself, using
+# the arch's launcher+model globs, so the kernels are discovered alongside the
+# launcher/model sources.
+fused_root      = "src/fused"
+# Project-supplied CUTLASS checkout; nvcc gets an explicit -I for it.
+cutlass_include = "third_party/cutlass/include"
+
+[sources.include_paths]
+extra = ["include"]
