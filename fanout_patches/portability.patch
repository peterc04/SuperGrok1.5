+def _opt_class_for(optimizer: str,
+                   config: Optional[Dict[str, Any]] = None) -> str:
+    """Stream A — config-extensible optimizer-class resolver.
+
+    Resolve a short optimizer name (e.g. ``"adamw"``) to the class string the
+    worker / timing / validation subprocesses import from the project package
+    (e.g. ``"AdamW"`` or, for a foreign project, ``"my_pkg.MyOpt"``). Lookup
+    order:
+
+      1. ``config["project"]["optimizer_classes"]`` — a ``{short: "pkg.Class"}``
+         map declared in the project TOML. Lets a foreign optimizer resolve
+         without a KeyError against the built-in registry.
+      2. The built-in :data:`OPT_CLASS` registry (re-exported from
+         ``dispatch.py``) — grokking's eleven optimizers.
+
+    A missing name raises ``KeyError`` exactly like ``OPT_CLASS[optimizer]``
+    did, so callers that relied on that behaviour are unchanged. With no config
+    (or a config that omits ``optimizer_classes``) this is byte-identical to a
+    direct ``OPT_CLASS[optimizer]`` lookup, so grokking is unaffected.
+    """
+    if isinstance(config, dict):
+        proj = config.get("project")
+        if isinstance(proj, dict):
+            ocmap = proj.get("optimizer_classes")
+            if isinstance(ocmap, dict) and optimizer in ocmap:
+                return str(ocmap[optimizer])
+    return OPT_CLASS[optimizer]
+
+
