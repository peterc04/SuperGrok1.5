+def _jit_module_name(spec: "BuildSpec", suffix: str = "") -> str:
+    """Stream A — portability: derive the JIT/AOT extension module name from
+    the project package instead of the hardcoded ``grokking_compiled_`` prefix.
+
+    The prefix is taken from ``spec.python_package`` (dots → underscores so the
+    result is a legal C identifier / module name), e.g. a project whose package
+    is ``"my_pkg.kernels"`` gets ``my_pkg_kernels_compiled_<opt>_<model>_<arch>``.
+
+    Grokking byte-identity: the historical module-name prefix is literally
+    ``grokking_compiled_`` even though the package is ``grokking_optimizers`` —
+    mirroring the ``_build_macros`` 2c special-case, when ``python_package`` is
+    the grokking default (or empty/unset) we emit the historical
+    ``grokking_compiled_`` prefix so the cache key and on-disk build dirs are
+    unchanged for the grokking project. ``suffix`` carries the per-variant tag
+    (e.g. ``"_<short_ckey>"``) appended verbatim, matching the existing sites.
+    """
+    pkg = getattr(spec, "python_package", "") or ""
+    if pkg in ("", "grokking_optimizers"):
+        prefix = "grokking_compiled_"
+    else:
+        prefix = f"{pkg.replace('.', '_')}_compiled_"
+    return f"{prefix}{spec.optimizer}_{spec.model}_{spec.arch}{suffix}"
+
