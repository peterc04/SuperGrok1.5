+# ── Generic record-and-replay capture (BuildSpec.capture_workload) ────────
+# The subprocess body that runs ONE real iteration of the project's workload
+# under a torch op-interception shim, snapshots the FIRST call to the target
+# op's positional inputs to a directory, and writes a JSON manifest the
+# oracle / variant-dump subprocesses replay. Project-agnostic: a project whose
+# kernel IS a torch op needs no hand-written hook — just point
+# ``capture_workload`` at a callable that runs the kernel once.
+#
+# Placeholders the host substitutes:
+#   __WORKLOAD__   — "pkg.mod:fn" (or "pkg.mod.fn") dotted path
+#   __INTERCEPT__  — short op name to snapshot (e.g. fused_lion_simple_step)
+#   __SNAPDIR__    — output snapshot directory
+#   __AOT_SO__     — AOT .so to load so torch.ops.<ns>.<op> is registered
+_CAPTURE_PROBE = r"""
+import os, sys, json, importlib
+import numpy as np
+import torch
+
+_SNAPDIR = r'''__SNAPDIR__'''
+_WANT = '''__INTERCEPT__'''
+_AOT_SO = r'''__AOT_SO__'''
+os.makedirs(_SNAPDIR, exist_ok=True)
+
+# Load the AOT artifact so the project's torch.ops.<ns>.<op> are registered
+# before the workload runs (a workload that imports the package may rely on
+# the .so already being present).
+if _AOT_SO and os.path.exists(_AOT_SO):
+    try:
+        torch.ops.load_library(_AOT_SO)
+    except Exception as exc:
+        sys.stderr.write("capture: load_library failed: %r\n" % (exc,))
+
+
+class _CaptureDone(Exception):
+    pass
+
+
+def _op_short_name(func):
+    # __torch_dispatch__ receives an OpOverload; .name() => "ns::op.overload".
+    try:
+        nm = func.name()
+    except Exception:
+        nm = str(func)
+    nm = nm.split(".")[0] if "." in nm else nm   # drop .overload suffix
+    return nm.split("::")[-1]                     # drop ns:: prefix
+
+
+def _snapshot(args):
+    manifest = {"snapshot_idx": 0, "args": []}
+    chosen = None
+    for i, a in enumerate(args):
+        if isinstance(a, torch.Tensor):
+            fp = os.path.join(_SNAPDIR, "arg_%d.npy" % i)
+            np.save(fp, a.detach().to("cpu").float().numpy())
+            manifest["args"].append({"kind": "tensor", "file": "arg_%d.npy" % i,
+                                     "torch_dtype": str(a.dtype).split(".")[-1]})
+            # Prefer the first tensor that is mutated in place as the snapshot
+            # target; fall back to the first tensor.
+            if chosen is None:
+                chosen = i
+        elif isinstance(a, bool):
+            manifest["args"].append({"kind": "scalar", "py": "bool", "value": bool(a)})
+        elif isinstance(a, int):
+            manifest["args"].append({"kind": "scalar", "py": "int", "value": int(a)})
+        elif isinstance(a, float):
+            manifest["args"].append({"kind": "scalar", "py": "float", "value": float(a)})
+        else:
+            # Unknown / non-replayable positional (e.g. a list) — record None so
+            # the arity stays correct; replay reconstructs it as a 0.
+            manifest["args"].append({"kind": "scalar", "py": "none", "value": None})
+    manifest["snapshot_idx"] = chosen if chosen is not None else 0
+    with open(os.path.join(_SNAPDIR, "manifest.json"), "w") as fh:
+        json.dump(manifest, fh)
+
+
+class _InterceptMode(torch.utils._python_dispatch.TorchDispatchMode):
+    def __torch_dispatch__(self, func, types, args=(), kwargs=None):
+        kwargs = kwargs or {}
+        if _op_short_name(func) == _WANT:
+            # Snapshot BEFORE running so an in-place op's inputs are pristine.
+            _snapshot(args)
+            out = func(*args, **kwargs)
+            raise _CaptureDone()
+        return func(*args, **kwargs)
+
+
+def _run_workload():
+    mod_attr = _WORKLOAD_DOTTED
+    if ":" in mod_attr:
+        mod_name, fn_name = mod_attr.split(":", 1)
+    else:
+        mod_name, fn_name = mod_attr.rsplit(".", 1)
+    mod = importlib.import_module(mod_name)
+    fn = getattr(mod, fn_name)
+    fn()
+
+
+_WORKLOAD_DOTTED = '''__WORKLOAD__'''
+try:
+    with _InterceptMode():
+        _run_workload()
+    # Workload finished without ever calling the target op.
+    sys.stderr.write("capture: target op %r never called by workload\n" % (_WANT,))
+    sys.exit(4)
+except _CaptureDone:
+    print("OK")
+    sys.exit(0)
+except SystemExit:
+    raise
+except Exception as exc:
+    import traceback
+    sys.stderr.write("capture: workload error: %r\n%s\n"
+                     % (exc, traceback.format_exc()))
+    sys.exit(5)
+"""
+
+
+def _capture_real_inputs(spec: "BuildSpec", aot_so_path: Path,
+                         snap_dir: Path, report,
+                         intercept_op: Optional[str] = None
+                         ) -> Optional[Path]:
+    """Generic record-and-replay capture (``BuildSpec.capture_workload``).
+
+    Runs ``spec.capture_workload`` ("pkg.mod:fn") for ONE iteration in a fresh
+    subprocess under a ``__torch_dispatch__`` op-interception shim, snapshots
+    the FIRST call to the target op's positional inputs to ``snap_dir`` (one
+    ``.npy`` per tensor arg + a ``manifest.json`` describing the full arg list
+    and the in-place/output ``snapshot_idx``), and returns ``snap_dir`` on
+    success. Returns ``None`` (so the caller falls back to schema-synthesis)
+    when no workload is configured, the manifest isn't produced, or the
+    subprocess fails — capture is OPTIONAL and must never break the sweep.
+
+    The op to intercept defaults to the short name of the resolved
+    ``fused_op_template`` (or an explicit ``[capture].intercept_op`` override);
+    matching is by short op name so it is robust to namespace/overload spelling.
+
+    Project-agnostic: a project whose kernel IS a torch op needs no
+    hand-written capture hook — replay supplies the oracle/variant dumps with
+    the REAL kernel inputs instead of synthesized ones.
+    """
+    workload = getattr(spec, "capture_workload", None)
+    if not workload:
+        return None
+    # Resolve which op to snapshot. Explicit override wins; else derive the
+    # short name from the configured fused-op template.
+    if intercept_op is None:
+        cap_cfg = ((getattr(spec, "config", None) or {}).get("capture", {})
+                   or {})
+        intercept_op = cap_cfg.get("intercept_op")
+    if intercept_op is None:
