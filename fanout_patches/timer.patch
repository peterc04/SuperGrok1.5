+# ---------------------------------------------------------------------------
+# Incremental per-variant build (BuildSpec.incremental_variant_build)
+# ---------------------------------------------------------------------------
+#
+# The biggest tuning-throughput lever: a variant differs from its siblings
+# ONLY in the swept ``-DSG_TUNED_*`` macros, which are read by a SMALL subset
+# of TUs (the kernel sources that ``#include`` a macro-reading header). The
+# other TUs (bindings, dispatch, non-kernel launchers) produce byte-identical
+# objects regardless of the macro value — recompiling them every variant is
+# pure waste.
+#
+# torch's ``cpp_extension.load`` applies ``extra_cflags`` GLOBALLY (one nvcc
+# command shared by all sources), so the macro tokens normally land on every
+# TU's command line and dirty every object. We confine them instead:
+#
+#   1. STRIP the ``-DSG_TUNED_*`` tokens from the global host/device flags, so
+#      the per-TU command string is now BYTE-STABLE across variants.
+#   2. Write those macros into a fixed-path header ``sg_tuned_variant.h`` in a
+#      SHARED, PERSISTENT build dir (re-used across the whole sweep).
+#   3. Replace each KERNEL TU with a thin, STABLE-named wrapper TU that
+#      ``#include``s ``sg_tuned_variant.h`` then the original source. Only the
+#      wrappers depend on the header; ninja's ``-MMD`` depfile tracking then
+#      recompiles ONLY the wrappers when the header content changes and SKIPS
+#      every macro-independent TU (byte-identical command, no header dep).
+#
+# Output is identical to passing ``-D`` globally (the macros reach exactly the
+# TUs that read them). If the dependency analysis is UNCERTAIN — no committed
+# source visible, the kernel-TU set is empty or is the whole source list, or
+# any IO fails — we return None and the caller does a normal full build. No
+# correctness risk: the fallback is the existing, proven path.
+
+_SG_TUNED_MACRO_RE = None
+
+
+def _split_sg_tuned_flags(flags: List[str]) -> Tuple[List[str], List[str]]:
+    """Partition ``flags`` into (non_tuned, tuned). A "tuned" flag is a
+    ``-DSG_TUNED_*[=...]`` define (the per-variant macros the sweep injects).
+    Pure / CPU-testable."""
+    tuned: List[str] = []
+    rest: List[str] = []
+    for f in flags:
+        if f.startswith("-DSG_TUNED_") or f.startswith("-D SG_TUNED_"):
+            tuned.append(f)
+        else:
+            rest.append(f)
+    return rest, tuned
+
+
+def _macros_to_header(tuned_flags: List[str]) -> str:
+    """Render ``-DNAME=VAL`` / ``-DNAME`` tokens as ``#define`` lines for the
+    shared variant header. Pure / CPU-testable."""
+    lines = ["// Auto-generated per-variant tuned macros "
+             "(incremental_variant_build).",
+             "// Regenerated each variant; ninja depfile tracking recompiles "
+             "only the kernel TUs that include this header.",
+             "#pragma once"]
+    for f in tuned_flags:
+        body = f[2:].lstrip()           # drop leading "-D" (and any space)
+        if "=" in body:
+            name, val = body.split("=", 1)
+            lines.append(f"#undef {name}")
+            lines.append(f"#define {name} {val}")
+        else:
+            lines.append(f"#undef {body}")
+            lines.append(f"#define {body} 1")
+    return "\n".join(lines) + "\n"
+
+
+def _transitive_reads_macro(src: Path, macro_stems: List[str],
+                            search_roots: List[Path],
+                            _seen: Optional[set] = None) -> Optional[bool]:
+    """True iff ``src`` or any file it transitively ``#include``s (resolved
+    within ``search_roots``) contains one of the ``macro_stems`` tokens.
+
+    Returns None when resolution is UNCERTAIN — an ``#include`` we cannot
+    locate on any search root (so we can't prove the TU is macro-independent
+    and must fall back to a full build). System ``<...>`` includes are ignored
+    (they never read project macros). Bounded by a visited-set."""
+    import re as _re
+    if _seen is None:
+        _seen = set()
+    src = Path(src)
+    rp = str(src.resolve())
+    if rp in _seen:
+        return False
+    _seen.add(rp)
+    try:
+        text = src.read_text(errors="ignore")
+    except OSError:
+        return None
+    for stem in macro_stems:
+        if stem in text:
+            return True
+    inc_re = _re.compile(r'^\s*#\s*include\s*"([^"]+)"', _re.MULTILINE)
+    for rel in inc_re.findall(text):
+        target: Optional[Path] = None
+        cand_dirs = [src.parent] + list(search_roots)
+        for d in cand_dirs:
+            c = (Path(d) / rel)
+            if c.is_file():
+                target = c
+                break
+        if target is None:
+            # Unresolvable local include — cannot prove independence.
+            return None
+        sub = _transitive_reads_macro(target, macro_stems, search_roots, _seen)
+        if sub is None:
+            return None
+        if sub:
+            return True
+    return False
+
+
+def _incremental_kernel_tus(sources: List[Path], tuned_flags: List[str],
+                            spec: "BuildSpec"
+                            ) -> Optional[List[Path]]:
+    """Dependency analysis for ``incremental_variant_build``.
+
+    Returns the subset of ``sources`` that transitively read one of the swept
+    ``SG_TUNED_*`` macros (the TUs that MUST recompile per variant), or None
+    when the analysis is uncertain / not worthwhile — in which case the caller
+    falls back to a full build (no correctness risk). None is returned when:
+
+      * there are no swept tuned macros (nothing to confine),
+      * any TU's include closure can't be fully resolved (can't prove a TU is
+        macro-independent),
+      * every TU reads the macros (no stable TU to reuse → no win),
+      * no TU reads the macros (the macros would be silently dropped — refuse
+        rather than change behaviour).
+    """
+    if not tuned_flags:
+        return None
+    # Macro stems to look for: the bare name (without -D / =VAL), plus the
+    # component/volume variants resolve_macros emits for tuple dims.
+    stems: List[str] = []
+    for f in tuned_flags:
+        body = f[2:].lstrip().split("=", 1)[0]
+        # A tuple dim emits FOO_0/_1/.../_VOLUME; match the FOO_ root so a TU
+        # reading any component counts as a kernel TU.
+        root = body
+        for suf in ("_VOLUME",):
+            if root.endswith(suf):
+                root = root[: -len(suf)]
+        # Strip a trailing _<digit> component index.
+        if root.rsplit("_", 1)[-1].isdigit():
+            root = root.rsplit("_", 1)[0]
+        stems.append(root)
+    stems = sorted(set(stems))
+    search_roots = [REPO_ROOT]
+    try:
+        for p in _include_paths(spec):
+            search_roots.append(Path(p))
+    except Exception:
+        return None
+    kernel: List[Path] = []
+    for s in sources:
+        res = _transitive_reads_macro(Path(s), stems, search_roots)
+        if res is None:
+            return None     # uncertain → full build
+        if res:
+            kernel.append(Path(s))
+    if not kernel or len(kernel) == len(sources):
+        # No reusable stable TU, or the macros reach nothing → no safe win.
+        return None
+    return kernel
+
+
+def _prepare_incremental_sources(
+        spec: "BuildSpec", sources: List[Path],
+        host_cflags: List[str], device_cflags: List[str],
+        shared_dir: Path, report
+) -> Optional[Tuple[List[Path], List[str], List[str], List[str]]]:
+    """Build the incremental variant inputs.
+
+    Returns ``(new_sources, new_host, new_device, extra_includes)`` where the
+    kernel TUs have been swapped for stable-named wrappers that ``#include`` a
+    regenerated ``sg_tuned_variant.h`` (written into ``shared_dir``), and the
+    ``-DSG_TUNED_*`` tokens have been stripped from the host/device flags.
+    Returns None to signal "fall back to a full build" (uncertain analysis or
+    any IO failure). Never raises."""
+    try:
+        _, tuned_host = _split_sg_tuned_flags(host_cflags)
+        _, tuned_device = _split_sg_tuned_flags(device_cflags)
+        tuned_all = list(dict.fromkeys(tuned_host + tuned_device))
+        kernel_tus = _incremental_kernel_tus(sources, tuned_all, spec)
+        if kernel_tus is None:
+            return None
+        shared_dir.mkdir(parents=True, exist_ok=True)
+        header = shared_dir / "sg_tuned_variant.h"
+        header.write_text(_macros_to_header(tuned_all))
+        kernel_set = {str(Path(k).resolve()) for k in kernel_tus}
+        new_sources: List[Path] = []
+        for s in sources:
+            if str(Path(s).resolve()) in kernel_set:
+                # Stable wrapper filename (per original TU): the path doesn't
+                # change across variants, so the only reason ninja recompiles
+                # it is the header content change (its depfile dependency).
+                wrap = shared_dir / f"_wrap_{Path(s).stem}{Path(s).suffix}"
+                wrap.write_text(
+                    f'#include "sg_tuned_variant.h"\n'
+                    f'#include "{Path(s).resolve()}"\n')
+                new_sources.append(wrap)
+            else:
+                new_sources.append(Path(s))
+        new_host, _ = _split_sg_tuned_flags(host_cflags)
+        new_device, _ = _split_sg_tuned_flags(device_cflags)
+        report.write(
+            f"  [incremental] reusing {len(sources) - len(kernel_tus)} "
+            f"unchanged TU object(s); recompiling {len(kernel_tus)} kernel TU"
+            f"(s) carrying {len(tuned_all)} SG_TUNED macro(s) "
+            f"[{', '.join(Path(k).name for k in kernel_tus)}].\n")
+        return new_sources, new_host, new_device, [str(shared_dir)]
+    except Exception as exc:
+        report.write(f"  [incremental] analysis/setup failed ({exc}); "
+                     f"falling back to a full build.\n")
+        _debug_swallow("_prepare_incremental_sources", exc)
+        return None
+
