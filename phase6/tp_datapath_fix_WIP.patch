     const int64_t need = dec_tc_workspace_floats(T, B, nCTA);
     DecTcLauncherScratch& sc = dec_tc_launcher_scratch(dev, need);
+    // OOM guard: if the workspace cudaMalloc failed (need can be hundreds of GB at
+    // the flagship production layout), refuse to launch rather than write through a
+    // null base (the wild-pointer IMA). Surface a clean error the caller can throw.
+    if (sc.workspace == nullptr || sc.ws_floats < need) return cudaErrorMemoryAllocation;
 
