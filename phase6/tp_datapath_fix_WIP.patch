--- a/csrc/fused/sm_90/mega_decoder_real_adamw_tc_launcher.cu
+++ b/csrc/fused/sm_90/mega_decoder_real_adamw_tc_launcher.cu
@@ -75,8 +75,21 @@ DecTcLauncherScratch& dec_tc_launcher_scratch(int dev, int64_t need_floats) {
     }
