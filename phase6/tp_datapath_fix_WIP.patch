         if (s.workspace) cudaFree(s.workspace);
-        cudaMalloc(&s.workspace, (size_t)need_floats * sizeof(float));
-        s.ws_floats = need_floats;
+        // OOM-SAFE: the flagship production-layout TC workspace is hundreds of GB
+        // (the staged-opt LookSAM 2·total + SG2 Nmax·nCTA carves); on an 80 GB GPU
+        // that cudaMalloc FAILS. Honor the error instead of leaving s.workspace at a
+        // stale/null pointer — a null workspace makes the kernel's lnvec/acts writes
+        // index a wild base (the +0x1dc30 IMA seen on the TP8 run). On failure leave
+        // s.workspace==nullptr + ws_floats==0 so the caller can detect it and return
+        // cudaErrorMemoryAllocation (no silent wild-pointer launch).
+        cudaError_t merr = cudaMalloc(&s.workspace, (size_t)need_floats * sizeof(float));
+        if (merr != cudaSuccess) {
+            s.workspace = nullptr;
+            s.ws_floats = 0;
+            (void)cudaGetLastError();   // clear the sticky error for the next try
+        } else {
+            s.ws_floats = need_floats;
+        }
     }
     return s;
 }
