;\n102\t\n103\t    const int nCTA = tc_effective_nctas(params, (int)ncta_cap);\n104\t    TcScratch& sc = tc_scratch_for(params, B, nCTA);\n105\t    auto grad = torch::zeros({total}, torch::dtype(torch::kFloat32).device(params.device()));\n106\t    auto loss_dev = torch::zeros({1}, torch::dtype(torch::kFloat32).device(params.device()));\n107\t\n108\t    PersistentContext ctx{\n109\t        sc.g_next.data_ptr<int>(),\n110\t        reinterpret_cast<unsigned*>(sc.g_arrived.data_ptr<int>()),\n111\t        reinterpret_cast<unsigned*>(sc.g_generation.data_ptr<int>()),\n112\t        ::sg::fused::sm90::kMambaNumTensors,\n113\t        0u};\n114\t\n115\t    FusedOptState st;\n116\t    float* m = state.data_ptr<float>();\n117\t    st.exp_avg = m;\n118\t    st.exp_avg_sq = m + total;\n119\t    st.lr = (float)lr; st.beta1 = (float)beta1; st.beta2 = (float)beta2;\n120\t    st.eps = (float)eps; st.wd = (float)weight_decay;\n121\t    st.bc1 = (float)bc1; st.bc2 = (float)bc2;\n122\t\n123\t    MambaTokenCtx tok;\n124\t    tok.tokens = tokens.data_ptr<int>();\n125\t    tok.targets = targets.data_ptr<int>();\n126\t    tok.B = B;\n127\t    tok.workspace = sc.workspace.data_ptr<float>();\n128\t    tok.loss_out = loss_dev.data_ptr<float>();\n129\t\n130\t    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n131\t    cudaError_t err = ::sg::fused::sm90::launch_fused_mamba_megakernel_tc<OptId::AdamW>(\n132\t        ctx, params.data_ptr<float>(), tok, grad.data_ptr<float>(),\n133\t        (float)lr, (int)step, st, stream, nCTA);\n134\t    TORCH_CHECK(err == cudaSuccess, \"TC mamba megakernel launch failed: \", cudaGetErrorString(err));\n135\t    C10_CUDA_CHECK(cudaStreamSynchronize(stream));\n136\t\n137\t    return {loss_dev.to(torch::kCPU), grad};\n138\t}\n139\t\n140\t// CALIBRATION HOOK (test_mamba_tc.py::test_tc_proj_dw_exact_on_own_operands):\n141\t// slice the kernel's OWN stored bf16 acts dY_dyout[L1] [T,d] and X_ygated[L1]\n142\t// [T,d_inner] from the workspace, returned as fp32 CPU tensors. The gate\n143\t// contracts them in fp32 ascending-t and compares to the kernel's\n144\t// out_proj.weight grad slice — isolating the output-stationary dW GEMM (K=T)\n145\t// from the operand-chain bf16 divergence. A ~1e-6 match proves the dW GEMM is\n146\t// bit-exact on its own operands, calibrating the per-tensor bf16 tol as headroom\n147\t// over a GEMM-exact floor. Reuses the cached workspace (call AFTER tc_train_step).\n148\tstatic std::vector<torch::Tensor> tc_dump_outproj_operands(torch::Tensor params, int64_t B) {\n149\t    TcScratch& sc = tc_scratch_for(params, (int)B, tc_effective_nctas(params, 4));\n150\t    const int T = (int)B * mb::kSeq;\n151\t    auto acts_bf16 = sc.workspace.slice(0, 0, mbtc::mb_acts_floats(T)).view(torch::kBFloat16);\n152\t    // walk mb_acts_bind to dY_dyout[1] and X_ygated[1].\n153\t    const int64_t d = mb::kD, di = mb::kDInner, dr = mb::kDtRank, dbc = mb::kDbc;\n154\t    const int64_t Td = (int64_t)T * d, Tdi = (int64_t)T * di, Tdr = (int64_t)T * dr,\n155\t                  Tdbc = (int64_t)T * dbc, T2di = (int64_t)T * 2 * di;\n156\t    int64_t off = 0, off_Xyg1 = -1, off_dYout1 = -1;\n157\t    for (int li = 0; li < mb::kLayers; ++li) {\n158\t        off += Td;            // X_in\n159\t        off += Tdi;           // X_xmain\n160\t        off += Tdr;           // X_dtraw\n161\t        if (li == 1) off_Xyg1 = off;\n162\t        off += Tdi;           // X_ygated\n163\t        off += T2di;          // dY_dxz\n164\t        off += Tdbc;          // dY_dxdbc\n165\t        off += Tdi;           // dY_ddtpre\n166\t        if (li == 1) off_dYout1 = off;\n167\t        off += Td;            // dY_dyout\n168\t    }\n169\t    auto dYout1 = acts_bf16.slice(0, off_dYout1, off_dYout1 + Td).to(torch::kFloat32).to(torch::kCPU);\n170\t    auto Xyg1 = acts_bf16.slice(0, off_Xyg1, off_Xyg1 + Tdi).to(torch::kFloat32).to(torch::kCPU);\n171\t    return {dYout1, Xyg1};   // [T*d], [T*d_inner]\n172\t}\n173\t\n174\t// scalar_train_step: the SAME (mamba × AdamW) cell run through the SCALAR default\n175\t// launcher (launch_fused_mamba_megakernel<AdamW>, OUTSIDE the wgmma guard — this\n176\t// wgmma-token TU can still call it). For the step-time gate to time scalar and TC\n177\t// back-to-back in one process / one contention regime → an honest scalar:TC ratio.\n178\t// The scalar path uses its OWN workspace (nCTA*total partials + nCTA loss + 1).\n179\t// NOT the shipped invocation (that is dispatch.cpp via mega_mamba_real_adamw.cu);\n180\t// a measurement mirror. Returns {loss, reduced grad}. NOTE: the scalar mamba\n181\t// kernel needs ~142KB DYNAMIC smem (its launcher does the opt-in internally).\n182\tstatic std::vector<torch::Tensor> scalar_train_step(\n183\t        torch::Tensor params, torch::Tensor tokens, torch::Tensor targets,\n184\t        torch::Tensor state, double lr, double beta1, double beta2, double eps,\n185\t        double weight_decay, double bc1, double bc2, int64_t step) {\n186\t    TORCH_CHECK(params.is_cuda() && params.scalar_type() == torch::kFloat32 && params.is_contiguous());\n187\t    TORCH_CHECK(params.numel() == kMambaTotalElems, \"params must be the flat mamba blob (\", kMambaTotalElems, \")\");\n188\t    TORCH_CHECK(tokens.is_cuda() && tokens.scalar_type() == torch::kInt32 && tokens.is_contiguous());\n189\t    TORCH_CHECK(targets.is_cuda() && targets.scalar_type() == torch::kInt32 && targets.is_contiguous());\n190\t    const int B = (int)targets.numel();\n191\t    TORCH_CHECK(tokens.numel() == (int64_t)B * mb::kSeq, \"tokens must be [B,kSeq]\");\n192\t    const int64_t total = kMambaTotalElems;\n193\t    TORCH_CHECK(state.is_cuda() && state.scalar_type() == torch::kFloat32 && state.is_contiguous()\n194\t                && state.numel() >= 3 * total, \"state must be contiguous fp32 [>=3*total]\");\n195\t\n196\t    int dev = params.get_device();\n197\t    int n_sms = 1;\n198\t    cudaDeviceGetAttribute(&n_sms, cudaDevAttrMultiProcessorCount, dev);\n199\t\n200\t    static torch::Tensor s_gn, s_ga, s_gg, s_ws;\n201\t    static int64_t s_ws_floats = 0;\n202\t    const int64_t need = (int64_t)n_sms * total + n_sms + 1;\n203\t    if (!s_gn.defined()) {\n204\t        auto oi = torch::dtype(torch::kInt32).device(params.device());\n205\t        s_gn = torch::zeros({1}, oi); s_ga = torch::zeros({1}, oi); s_gg = torch::zeros({1}, oi);\n206\t    }\n207\t    if (s_ws_floats < need) {\n208\t        s_ws = torch::empty({need}, torch::dtype(torch::kFloat32).device(params.device()));\n209\t        s_ws_floats = need;\n210\t    }\n211\t    auto grad = torch::zeros({total}, torch::dtype(torch::kFloat32).device(params.device()));\n212\t    float* loss_out = s_ws.data_ptr<float>() + (int64_t)n_sms * total + n_sms;\n213\t\n214\t    PersistentContext ctx{\n215\t        s_gn.data_ptr<int>(),\n216\t        reinterpret_cast<unsigned*>(s_ga.data_ptr<int>()),\n217\t        reinterpret_cast<unsigned*>(s_gg.data_ptr<int>()),\n218\t        ::sg::fused::sm90::kMambaNumTensors, 0u};\n219\t\n220\t    FusedOptState st;\n221\t    float* m = state.data_ptr<float>();\n222\t    st.exp_avg = m; st.exp_avg_sq = m + total;\n223\t    st.lr = (float)lr; st.beta1 = (float)beta1; st.beta2 = (float)beta2;\n224\t    st.eps = (float)eps; st.wd = (float)weight_decay;\n225\t    st.bc1 = (float)bc1; st.bc2 = (float)bc2;\n226\t\n227\t    MambaTokenCtx tok;\n228\t    tok.tokens = tokens.data_ptr<int>();\n229\t    tok.targets = targets.data_ptr<int>();\n230\t    tok.B = B;\n231\t    tok.workspace = s_ws.data_ptr<float>();\n232\t    tok.loss_out = loss_out;\n233\t\n234\t    cudaStream_t stream = c10::cuda::getCurrentCUDAStream().stream();\n235\t    cudaError_t err = ::sg::fused::sm90::launch_fused_mamba_megakernel<OptId::AdamW>(\n236\t        ctx, params.data_ptr<float>(), tok, grad.data_ptr<float>(),\n237\t        (float)lr, (int)step, st, stream);\n238\t    TORCH_CHECK(err == cudaSuccess, \"scalar mamba megakernel launch failed: \", cudaGetErrorString(err));\n239\t    C10_CUDA_CHECK(cudaStreamSynchronize(stream));\n240\t\n241\t    auto loss_cpu = s_ws.slice(0, (int64_t)n_sms * total + n_sms, (int64_t)n_sms * total + n_sms + 1)\n242\t                        .to(torch::kCPU);\n243\t    return {loss_cpu, grad};\n244\t}\n245\t\n246\tPYBIND11_MODULE(TORCH_EXTENSION_NAME, mm) {\n247\t    mm.def(\"tc_train_step\", &tc_train_step,\n248\t           \"Fork-B tensor-core mamba fwd+bwd+AdamW step (in place); returns (loss, reduced grad)\",\n249\t           pybind11::arg(\"params\"), pybind11::arg(\"tokens\"), pybind11::arg(\"targets\"),\n250\t           pybind11::arg(\"state\"), pybind11::arg(\"lr\"), pybind11::arg(\"beta1\"),\n251\t           pybind11::arg(\"beta2\"), pybind11::arg(\"eps\"), pybind11::arg(\"weight_decay\"),\n252\t           pybind11::arg(\"bc1\"), pybind11::arg(\"bc2\"), pybind11::arg(\"step\"),\n253\t           pybind11::arg(\"ncta_cap\") = 0);\n254\t    mm.def(\"tc_dump_outproj_operands\", &tc_dump_outproj_operands,\n255\t           \"gate-only: dump the kernel's stored dY_dyout[L1], X_ygated[L1] (fp32 CPU)\");\n256\t    mm.def(\"scalar_train_step\", &scalar_train_step,\n257\t           \"gate-only: SAME cell via the SCALAR launcher (back-to-back step-time mirror)\",\n258\t           pybind11::arg(\"params\"), pybind11::arg(\"tokens\"), pybind11::arg(\"targets\"),\n259\t           pybind11::arg(\"state\"), pybind11::arg(\"lr\"), pybind11::arg(\"beta1\"),\n260\t           pybind11::arg(\"beta2\"), pybind11::arg(\"eps\"), pybind11::arg(\"weight_decay\"),\n261\t           pybind11::arg(\"bc1\"), pybind11::arg(\"bc2\"), pybind11::arg(\"step\"));\n262\t    mm.attr(\"TILE_M\") = (int)mbtc::kTileM;\n263\t    mm.attr(\"TILE_N\") = (int)SG_TUNED_TILE_N;\n264\t    mm.attr(\"TOTAL\") = (int)kMambaTotalElems;\n265\t}\n266\t"}]},"uuid":"8378ef6e-ebc5-42c0-a56a-935d9cc49c8c","timestamp":"2026-06-11T14:27:41.411Z","sourceToolAssistantUUID":"4120b02a-c923-43dc-a410-c8ec18547c2e","userType":"external","entrypoint":"cli","cwd":"/workspace/SuperGrok