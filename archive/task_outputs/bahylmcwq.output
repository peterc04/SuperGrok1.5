_param_spec():\n257:    from tests.hw.mamba_oracle import mamba_param_layout\n258:    lay = mamba_param_layout()\n284:def test_tc_single_step_grad_parity():\n289:    from tests.hw.mamba_oracle import mamba_param_layout\n293:    named = _eager_mamba_named(seed=123)\n296:    from tests.hw.mamba_oracle import VOCAB, P_HEAD, SEQ\n299:    loss_o, grads_o = _bf16_faithful_mamba_oracle(named, tokens, targets)\n310:    lay = mamba_param_layout()\n338:def test_tc_proj_dw_exact_on_own_operands():\n339:    \"\"\"(2) The output-stationary dW GEMM (K=T) is bit-exact on the kernel's OWN\n343:    from tests.hw.mamba_oracle import (mamba_param_layout, D_MODEL, D_INNER, SEQ, VOCAB, P_HEAD)\n347:    named = _eager_mamba_named(seed=7)\n364:    lay = mamba_param_layout()\n371:    assert rel < 5e-3, f\"proj-dW ISO rel {rel:.2e} — the dW GEMM is NOT bit-exact on its own operands (a real bug)\"\n375:def test_tc_determinism():\n376:    \"\"\"(3) A/A/A bit-identical: three TC steps from the same state produce\n377:    bit-identical (loss, grad). Fixed tile/dW/partial ownership + ascending-k/t/CTA.\"\"\"\n378:    from tests.hw.mamba_oracle import VOCAB, P_HEAD, SEQ\n382:    named = _eager_mamba_named(seed=3)","is_error":false}]},"uuid":"abb2eacd-b999-4c3a-a7f0-d1896126c40c","timestamp":"2026-06-11T14:27:22.902Z","sourceToolAssistantUUID":"2658bbfe-33a5-4ebc-a0cd-eb1bac368e64","userType":"external","entrypoint":"cli","cwd":"/workspace/SuperGrok1.5","sessionId":"122b3aee-fa74-43c0-936d-39ff1eca854f","version":"2.1.169","gitBranch":"claude/h100-audit-maximal","slug":"delegated-hugging-quill"}
/workspace/SuperGrok1.5/claude_session_archive/projects/-workspace-SuperGrok1-5/122b3aee-fa74-43c0-936d-39ff1eca854f/subagents/agent-a3367899cdd0af81c.jsonl:64:{"parentUuid":"eea5085b-22ce-4101-9644-77e074ca327d","isSidechain":true,"promptId":"97f59445-da7a-4913-ae29-6890d9a9df3a","agentId":"a3367899cdd0af81c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KvrvaVt4nVmRVRkCc3MGpj","type":"tool_result","content":"375\tdef test_tc_determinism():\n376\t    \"\"\"(3) A/A/A bit-identical: three TC steps from the same state produce\n377\t    bit-identical (loss, grad). Fixed tile/dW/partial ownership + ascending-k/t/CTA.\"\"\"\n378\t    from tests.hw.mamba_oracle import VOCAB, P_HEAD, SEQ\n379\t    mod = _build_tc_module()\n380\t    _disable_tf32()\n381\t    dev = \"cuda\"\n382\t    named = _eager_mamba_named(seed=3)\n383\t    B = 64\n384\t    g = torch.Generator().manual_seed(9)\n385\t    tokens = torch.randint(0, VOCAB, (B, SEQ), generator=g).to(dev)\n386\t    targets = torch.randint(0, P_HEAD, (B,), generator=g).to(dev)\n387\t    params = _flat(named).to(dev)\n388\t    total = int(mod.TOTAL)\n389\t    outs = []\n390\t    for _ in range(3):\n391\t        state = torch.zeros(3 * total, dtype=torch.float32, device=dev)\n392\t        loss, grad = _run_tc_step(mod, params.clone(), tokens, targets, state,\n393\t                                  lr=1e-3, betas=(0.9, 0.98), wd=0.0, eps=1e-8, step=1)\n394\t        outs.append((float(loss.item()), grad.clone()))\n395\t    for i in (1, 2):\n396\t        assert outs[i][0] == outs[0][0], f\"loss not bit-identical: {outs[i][0]} vs {outs[0][0]}\"\n397\t        assert torch.equal(outs[i][1], outs[0][1]), \"grad not bit-identical (A/A/A)\"\n398\t    print(f\"[mbtc] determinism A/A/A: loss {outs[0][0]:.8f} bit-identical, grad max-Δ=0\")\n399\t\n400\t\n401\t@_GATE\n402\tdef test_tc_short_trajectory():\n403\t    \"\"\"(4) 50 TC steps: the loss decreases and stays finite (the trained cell is a\n404\t    real optimizer over the real grad — a broken grad diverges or stalls).\"\"\"\n405\t    from tests.hw.mamba_oracle import VOCAB, P_HEAD, SEQ\n406\t    mod = _build_tc_module()\n407\t    _disable_tf32()\n408\t    dev = \"cuda\"\n409\t    named = _eager_mamba_named(seed=21)\n410\t    B = 64\n411\t    g = torch.Generator().manual_seed(13)\n412\t    tokens = torch.randint(0, VOCAB, (B, SEQ), generator=g).to(dev)\n413\t    targets = torch.randint(0, P_HEAD, (B,), generator=g).to(dev)\n414\t    params = _flat(named).to(dev).clone()\n415\t    total = int(mod.TOTAL)\n416\t    state = torch.zeros(3 * total, dtype=torch.float32, device=dev)\n417\t    losses = []\n418\t    for step in range(1, 51):\n419\t        loss, _ = _run_tc_step(mod, params, tokens, targets, state,\n420\t                               lr=5e-3, betas=(0.9, 0.98), wd=0.0, eps=1e-8, step=step)\n421\t        losses.append(float(loss.item()))\n422\t    print(f\"[mbtc] trajectory: loss[0]={losses[0]:.4f} loss[49]={losses[-1]:.4f} min={min(losses):.4f}\")\n423\t    assert all(l == l for l in losses), \"NaN in trajectory\"\n424\t    assert losses[-1] < losses[0] - 0.1, f\"loss did not decrease: {losses[0]:.3f} → {losses[-1]:.3f}\"\n425\t\n426\t\n427\t@_GATE\n428\tdef test_tc_step_time_vs_scalar():\n429\t    \"\"\"(5) step-time TC vs scalar, back-to-back in one process (informational; the\n430\t    fleet may be live). Only the 4 projections are TC + the scalar scan is a big\n431\t    share of Mamba FLOPs, so expect a MODEST speedup, not the decoder's 1.8×.\"\"\"\n432\t    import time\n433\t    from tests.hw.mamba_oracle import VOCAB, P_HEAD, SEQ\n434\t    mod = _build_tc_module()\n435\t    _disable_tf32()\n436\t    dev = \"cuda\"\n437\t    named = _eager_mamba_named(seed=2)\n438\t    B = 64\n439\t    g = torch.Generator().manual_seed(4)\n440\t    tokens = torch.randint(0, VOCAB, (B, SEQ), generator=g).to(dev)\n441\t    targets = torch.randint(0, P_HEAD, (B,), generator=g).to(dev)\n442\t    params = _flat(named).to(dev)\n443\t    total = int(mod.TOTAL)\n444\t    state = torch.zeros(3 * total, dtype=torch.float32, device=dev)\n445\t\n446\t    def time_fn(fn, n=20):\n447\t        fn()  # warm\n448\t        torch.cuda.synchronize()\n449\t        t0 = time.perf_counter()\n450\t        for _ in range(n):\n451\t            fn()\n452\t        torch.cuda.synchronize()\n453\t        return (time.perf_counter() - t0) / n * 1e3  # ms\n454\t\n455\t    bc1 = 1 - 0.9; bc2 = 1 - 0.98\n456\t    tc = time_fn(lambda: mod.tc_train_step(params.clone(), tokens.to(torch.int32), targets.to(torch.int32),\n457\t                                           state, 1e-3, 0.9, 0.98, 1e-8, 0.0, bc1, bc2, 1, _TC_NCTA_CAP))\n458\t    try:\n459\t        sc = time_fn(lambda: mod.scalar_train_step(params.clone(), tokens.to(torch.int32), targets.to(torch.int32),\n460\t                                                   state, 1e-3, 0.9, 0.98, 1e-8, 0.0, bc1, bc2, 1))\n461\t        print(f\"[mbtc] step-time TC={tc:.3f}ms scalar={sc:.3f}ms ratio={sc/tc:.2f}× (informational)\")\n462\t    except Exception as e:\n463\t        print(f\"[mbtc] step-time TC={tc:.3f}ms (scalar mirror unavailable: {e!r})\")\n464\t\n465\t\n466\tdef _main():\n467\t    if not _sm90a_available():\n468\t        print(\"SKIP: no sm_90 GPU\"); return\n469\t    fails = []\n470\t\n471\t    def _try(name, fn):\n472\t        try:\n473\t            fn(); print(f\"  [PASS] {name}\")\n474\t        except Exception as e:\n475\t            fails.append((name, repr(e))); print(f\"  [FAIL] {name}: {e!r}\")\n476\t\n477\t    _try(\"(1) single-step grad parity (KEYSTONE)\", test_tc_single_step_grad_parity)\n478\t    _try(\"(2) proj-dW ISO (own operands)\", test_tc_proj_dw_exact_on_own_operands)\n479\t    _try(\"(3) determinism A/A/A\", test_tc_determinism)\n480\t    _try(\"(4) short trajectory (50)\", test_tc_short_trajectory)\n481\t    _try(\"(5) step-time vs scalar\", test_tc_step_time_vs_scalar)\n482\t    print()\n483\t    if fails:\n484\t        print(f\"FAILURES ({len(fails)}):\")\n485\t        for n, e in fails:\n486\t            print(f\"  {n}: {e}\")\n487\t        sys.exit(1)\n488\t    print(\"ALL MAMBA TC GATES PASSED\")\n489\t\n490\t\n491\tif __name__ == \"__main__\":\n492\t    _main()"}]},"uuid":"68a98cd4-e989-4633-81d7-15cf8734a3d5","timestamp":"2026-06-11T14:27:31.169Z","sourceToolAssistantUUID":"eea5085b-22ce-4101-9644-77e074ca327d","userType":"external","entrypoint":"cli","cwd":"/workspace/SuperGrok1.5","sessionId":"122b3aee-fa74-43c0-936d-39ff1eca854f","version":"2.1.169","gitBranch":"claude/h100-audit-maximal","slug":"delegated-hugging-quill"}
